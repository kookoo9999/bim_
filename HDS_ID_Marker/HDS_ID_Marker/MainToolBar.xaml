<UserControl x:Class="HDS_ID_Marker.MainToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HDS_ID_Marker"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" FontFamily="Roboto"
             d:DesignHeight="100" d:DesignWidth="1440">

    <Grid Height="Auto" Width="Auto">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160*"/>
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="80*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="80*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="80*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="80*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="80*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="Silver" BorderThickness="1" Name="bdrStatus" Background="#323232" CornerRadius="5">
            <Label FontSize="50" FontWeight="Bold" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" Name="lblStatus" Foreground="White">검사대기</Label>
        </Border>

        <Border Grid.Column="1" Background="#e5e5e5" Width="1" VerticalAlignment="Stretch" SnapsToDevicePixels="True" />

        <!--<Button Grid.Column="5" Name="toolButton1" Template="{DynamicResource MenuButtonStyle2}" Cursor="Hand" Tag="ModelManager">모델 관리</Button>-->

        <Button Grid.Column="2" Name="btnAuto" Cursor="Hand" Tag="Marking" Style="{StaticResource MaterialDesignCircleBtn}"
                    Width="100" Height="Auto" Click="ToolButtonClick" MouseEnter="btnAuto_MouseEnter" MouseLeave="btnAuto_MouseLeave">
            <StackPanel>
                <materialDesign:PackIcon Name="ImgAuto" Kind="Play" Width="70" Height="70" HorizontalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Border Grid.Column="3" Background="#e5e5e5" Width="1" VerticalAlignment="Stretch" SnapsToDevicePixels="True" />

        <Button Grid.Column="4" Style="{StaticResource MaterialDesignBtn}" Name="btnModel" Cursor="Hand" Tag="ModelManager" Height="Auto" Width="Auto" 
                Click="ToolButtonClick" MouseEnter="btnModel_MouseEnter" MouseLeave="btnModel_MouseLeave">
            <StackPanel>
                <materialDesign:PackIcon Name="imgModelManager" Kind="FolderEditOutline" Width="65" Height="65" HorizontalAlignment="Center"
                                         Foreground="Black"/>
                <Label x:Name="lblModelManager" FontFamily="Roboto" FontWeight="Bold" FontSize="20">모델 관리</Label>
            </StackPanel>
        </Button>

        <Border Grid.Column="5" Background="#e5e5e5" Width="1" VerticalAlignment="Stretch" SnapsToDevicePixels="True" />
        
        <!--<Button Grid.Column="7" Name="toolButton2" Template="{DynamicResource MenuButtonStyle2}" Cursor="Hand" Tag="Align">얼라인 설정</Button>-->
        
        <Button Grid.Column="6" Style="{StaticResource MaterialDesignBtn}" Name="btnTest" Cursor="Hand" Tag="TEACHING" Height="Auto" Width="Auto" 
                Click="ToolButtonClick" MouseEnter="btnTest_MouseEnter" MouseLeave="btnTest_MouseLeave">
            <StackPanel>
                <materialDesign:PackIcon Name="imgTest" Kind="Teacher" Width="65" Height="65" HorizontalAlignment="Center"
                                         Foreground="Black"/>
                <Label x:Name="lblTest" FontFamily="Roboto" FontWeight="Bold" FontSize="20">티칭/테스트</Label>
            </StackPanel>
        </Button>

        <Border Grid.Column="7" Background="#e5e5e5" Width="1" VerticalAlignment="Stretch" SnapsToDevicePixels="True" />


        <Button Grid.Column="8" Style="{StaticResource MaterialDesignBtn}" Name="btnInfo" Cursor="Hand" Tag="VIEWINFO" Height="Auto" Width="Auto" 
                Click="ToolButtonClick" MouseEnter="btnInfo_MouseEnter" MouseLeave="btnInfo_MouseLeave">
            <StackPanel>
                <materialDesign:PackIcon Name="imgInfoView" Kind="BallotOutline" Width="65" Height="65" HorizontalAlignment="Center"
                                         Foreground="Black"/>
                <Label x:Name="lblInfoView" FontFamily="Roboto" FontWeight="Bold" FontSize="20" HorizontalContentAlignment="Center">정보 보기</Label>
            </StackPanel>
        </Button>

        <Border Grid.Column="9" Background="#e5e5e5" Width="1" VerticalAlignment="Stretch" SnapsToDevicePixels="True" />

        <Button Grid.Column="10" Style="{StaticResource MaterialDesignBtn}" Name="btnExit" Cursor="Hand" Tag="EXIT" Height="Auto" Width="Auto" 
                Click="ToolButtonClick" MouseEnter="btnExit_MouseEnter" MouseLeave="btnExit_MouseLeave">
            <StackPanel>
                <materialDesign:PackIcon Name="imgExit" Kind="ExitToApp" Width="65" Height="65" HorizontalAlignment="Center"
                                         Foreground="Black"/>
                <Label x:Name="lblExit" FontFamily="Roboto" FontWeight="Bold" FontSize="20" HorizontalContentAlignment="Center">종료</Label>
            </StackPanel>
        </Button>
        <!--<Button Grid.Column="11" Name="toolButton4" Template="{DynamicResource MenuButtonStyle2}" Cursor="Hand" Tag="Setting">환경 설정</Button>
        <Button Grid.Column="13" Name="toolButton9" Template="{DynamicResource MenuButtonStyle2}" Cursor="Hand" Tag="Close" Style="{StaticResource NullBackgroundButtonStyle}">
            <Image Source="Images/off.png" Width="80"/>
        </Button>-->


        
    </Grid>
</UserControl>
