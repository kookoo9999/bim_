<mah:MetroWindow  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" x:Class="HDS_ID_Marker.ModelManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDS_ID_Marker" WindowStartupLocation="CenterScreen"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" FontFamily="Roboto" Icon="images/modelManagement.png"
        xmlns:common="clr-namespace:Common;assembly=Common" xmlns:ToggleSwitch="clr-namespace:ToggleSwitch;assembly=ToggleSwitch"
                  Title="모델 관리" Height="850" Width="1000" TitleForeground="Black" WindowTitleBrush="White" BorderThickness="0">


    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="350"/>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">

                <materialDesign:ColorZone
                                Foreground="White"
                                Background="#4c7eb6"
                                Mode="Standard"
                                CornerRadius="3" 
                                materialDesign:ShadowAssist.ShadowDepth="Depth2" Height="40">
                    <TextBlock
                                    x:Name="txtModelName" VerticalAlignment="Center" TextWrapping="Wrap" 
                                    HorizontalAlignment="Center"
                                    FontSize="25" FontWeight="Bold"
                                    FontFamily="Roboto">
                                    선택된 모델이 없습니다.
                    </TextBlock>
                </materialDesign:ColorZone>

            </Border>

            <!-- C / M / D horizontal button panel -->
            <Grid Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="1, 4, 1, 2" x:Name="btnRenameModel" Tag="Rename">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="FolderEdit" Width="18" Height="18" HorizontalAlignment="Center" Foreground="white"/>
                        <TextBlock FontWeight="Normal" FontSize="16" Text="모델변경" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Margin="1, 4, 1, 2" Name="btnCreateModel" Tag="Create">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="AddThick" Width="18" Height="18" HorizontalAlignment="Center" Foreground="white"/>
                        <TextBlock FontWeight="Normal" FontSize="16" Text="모델 추가" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="2" Margin="1, 4, 1, 2" Name="btnModifyModel" Tag="Modify">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="FileDocumentEdit" Width="18" Height="18" HorizontalAlignment="Center" Foreground="white"/>
                        <TextBlock FontWeight="Normal" FontSize="16" Text="모델 수정" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="3" Margin="1, 4, 1, 2" Name="btnDeleteModel" Tag="Delete">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="DeleteVariant" Width="18" Height="18" HorizontalAlignment="Center" Foreground="white"/>
                        <TextBlock FontWeight="Normal" FontSize="16" Text="모델 삭제" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                    </StackPanel>
                </Button>
            </Grid>
            <!-- No. | Model -->
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0, 2, 0, 0" Orientation="Horizontal">
                <StackPanel.Effect>
                    <DropShadowEffect ShadowDepth="5" Direction="310" Color="DarkGray" BlurRadius="4" Opacity="0.5"/>
                </StackPanel.Effect>

                <materialDesign:ColorZone
                                Mode="Custom"
                                CornerRadius="6" 
                                materialDesign:ShadowAssist.ShadowDepth="Depth1">
                </materialDesign:ColorZone>

                <TextBlock Text="No." Width="50" VerticalAlignment="Center" FontSize="12" Margin="10, 0, 0, 0"/>
                <TextBlock Text="Model" VerticalAlignment="Center" FontSize="12" Margin="10, 0, 0, 0"/>
                <TextBox                 
                    x:Name="tbModelSearch"
                    Style="{StaticResource SimpleTextBox}"
                         VerticalContentAlignment="Center" 
                         HorizontalContentAlignment="Center"
                         Grid.Column="1" Grid.ColumnSpan="2"
                         Grid.Row="5"
                         Margin="30 0 0 0"
                         materialDesign:HintAssist.Hint="모델명"
                         BorderThickness="1" FontSize="20"                    
                         Height="30" Text="" Width="300" Focusable="True"
                         VerticalAlignment="Center" />
                <Button Grid.Column="2" Margin="2 0 5 0"  Content="검색" Height="20" Name="btnSearchModel" FontSize="12" FontWeight="Bold" Foreground="white"/>
            </StackPanel>
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#FF919191" BorderThickness="1" Margin="0, 2, 0, 0"/>

            <!-- listbox -->
            <ScrollViewer x:Name="svModel" Background="White"
                Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">
                <ScrollViewer.Effect>
                    <DropShadowEffect ShadowDepth="5" Direction="310" Color="DarkGray" BlurRadius="4" Opacity="0.5"/>
                </ScrollViewer.Effect>
                <ListBox x:Name="lbModel" ItemsSource="{Binding}" IsSynchronizedWithCurrentItem="True" Foreground="Black">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding modelInformation.Index}" Margin="15, 0, 0, 0"/>
                                <TextBlock Grid.Column="1" Text="{Binding modelInformation.Name}" Margin="15, 0, 0, 0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <Border Background="White" Grid.Row="5" Grid.ColumnSpan="3">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="5" Direction="310" Color="DarkGray" BlurRadius="4" Opacity="0.5"/>
                </Border.Effect>
                <Image Source="Images/strip.png" Stretch="UniformToFill" SnapsToDevicePixels="True" Margin="0"/>
            </Border>

            <Grid Grid.Column="4" Grid.RowSpan="7" Grid.ColumnSpan="3" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="9*"/>
                </Grid.RowDefinitions>
                <Grid Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Margin="5 0 5 0" Content="PLC 전송" Name="btnPLC" FontSize="20" FontWeight="Bold" Foreground="white" Visibility="Hidden"/>
                    <Button Grid.Column="2" Margin="5 0 5 0" Content="시   작" Name="btnStart" FontSize="20" FontWeight="Bold" Foreground="white"/>
                </Grid>
                <Grid Background="White" x:Name="pnlModelSpec" Margin="0,68,0,0" Grid.RowSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="62*"/>
                        <RowDefinition Height="62*"/>
                        <RowDefinition Height="62*"/>
                        <RowDefinition Height="62*"/>
                        <RowDefinition Height="62*"/>
                        <RowDefinition Height="62*"/>
                        <RowDefinition Height="62*"/>
                        <RowDefinition Height="62*"/>                        
                        <RowDefinition Height="62*"/>
                        <RowDefinition Height="62*"/>
                        <RowDefinition Height="62*"/>
                    </Grid.RowDefinitions>

                    <materialDesign:ColorZone Grid.Row="1" Grid.ColumnSpan="4"
                                Mode="Custom"
                                Background="#4c7eb6"
                                CornerRadius="0" 
                                materialDesign:ShadowAssist.ShadowDepth="Depth2">
                        <Label FontSize="16" FontFamily="Roboto" FontWeight="Bold" Foreground="White" HorizontalContentAlignment="Center">모델 정보</Label>
                    </materialDesign:ColorZone>

                    <Label Grid.Row="2" VerticalAlignment="Center" Margin="5,0" FontSize="16">Gerber File</Label>
                    <TextBox                 
                                    x:Name="tbGerberPath"
                                    Style="{StaticResource SimpleTextBox}"
                                         VerticalContentAlignment="Center"
                                         Grid.Column="1" Grid.ColumnSpan="2"
                                         Grid.Row="2"
                                         Margin="8 0 8 0"
                                         materialDesign:HintAssist.Hint="거버 파일에서 Strip Pitch 추출"
                                         BorderThickness="1"
                                         Height="30" Text="{Binding modelInformation.GerberPath}"
                                         VerticalAlignment="Center" />
                    <Button x:Name="btnGerber" Click="btnGerber_Click" Grid.Column="3" Grid.Row="2" Width="28" Height="28" Foreground="Transparent" Background="Transparent" Padding="0" BorderThickness="0" ToolTip="On/Off"
                                        materialDesign:RippleAssist.Feedback="DarkGray">
                        <materialDesign:PackIcon Kind="Folder" Foreground="Gray" Width="25" Height="25"/>
                    </Button>

                    <Label  Grid.Row="3" VerticalAlignment="Center" Margin="5, 0" FontSize="16">제품 길이</Label>
                    <Label  Grid.Row="4" VerticalAlignment="Center" Margin="5, 0" FontSize="16">고객사</Label>
                    <Label  Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" Margin="5, 0">mm</Label>

                    <common:NumberTextBox x:Name="tbPanelLength" Grid.Row="3" Grid.Column="2" MinValue="0.0" MaxValue="500.0" Round="3" VerticalContentAlignment="Center" Margin="10"
                                            HorizontalContentAlignment="Center" FontSize="25" Text="{Binding modelInformation.PanelLength}"/>

                    <ComboBox Grid.Row="4" Grid.Column="2" Name="cbCustomer" FontSize="16" VerticalContentAlignment="Center"/>

                    <materialDesign:ColorZone
                        Grid.Row="29" Grid.ColumnSpan="4" VerticalAlignment="Center"
                                Mode="Standard"
                                CornerRadius="3" 
                                materialDesign:ShadowAssist.ShadowDepth="Depth2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 1">
                            <Button Name="btnSave" Width="100" Height="40">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" HorizontalAlignment="Center" Foreground="white"/>
                                    <TextBlock FontWeight="Normal" FontSize="16" Text="저 장" VerticalAlignment="Center" Margin="10, 0, 10, 0" Foreground="white"/>
                                </StackPanel>
                            </Button>
                            <Button Name="btnCancel" Width="100" Height="40" Margin="15, 0" FontSize="16" Foreground="white" Click="btnCancel_Click">취 소</Button>
                        </StackPanel>
                    </materialDesign:ColorZone>

                    <Label Grid.Row="5" VerticalAlignment="Center" FontSize="16" Content="고객 모델명"/>
                    <TextBox                 
                                    x:Name="tbCustModelName"
                                    Style="{StaticResource SimpleTextBox}"
                                         VerticalContentAlignment="Center" 
                                         HorizontalContentAlignment="Center"
                                         Grid.Column="1" Grid.ColumnSpan="2"
                                         Grid.Row="5"
                                         Margin="8 0 8 0"
                                         materialDesign:HintAssist.Hint="고객 모델명 입력"
                                         BorderThickness="1" FontSize="20"
                                         Height="30" Text="{Binding modelInformation.CustModelName}"
                                         VerticalAlignment="Center" />
                    
                    <Label  Grid.Row="6" VerticalAlignment="Center" FontSize="16" Content="AOI 마크"/>                    
                    <Label  Grid.Row="10" VerticalAlignment="Center" FontSize="16" Content="마킹 검사" Visibility="Visible"/>
                    <Label  Grid.Row="11" VerticalAlignment="Center" FontSize="16" Content="2D Shift 검사" Visibility="Visible"/>
                    <Label  Grid.Row="7" VerticalAlignment="Center" FontSize="16" Content="Strip 열 배열"/>
                    <Label  Grid.Row="10" VerticalAlignment="Center" FontSize="16" Content="Strip 2D 위치" Visibility="Hidden"/>
                    <Label x:Name="lblCoilerDir" Grid.Row="9" VerticalAlignment="Center" FontSize="16" Content="코일러 방향"/>
                    <GroupBox Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource MaterialDesignHeaderedContentControl}" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="rbAOIUse"  FontSize="16" Content="사용"/>
                            <RadioButton x:Name="rbAOINot"  FontSize="16" Grid.Column="1" Content="미사용"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Visibility="Visible" Grid.Row="10" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource MaterialDesignHeaderedContentControl}" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="rbMarkingCheckUse" IsChecked="True" FontSize="16" Content="사용"/>
                            <RadioButton x:Name="rbMarkingCheckNot" FontSize="16" Grid.Column="1" Content="미사용"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Visibility="Visible" Grid.Row="11" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource MaterialDesignHeaderedContentControl}" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="rbMarkingShiftCheckUse" IsChecked="False" FontSize="16" Content="사용"/>
                            <RadioButton x:Name="rbMarkingShiftCheckNot" IsChecked="True" FontSize="16" Grid.Column="1" Content="미사용"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="7" Grid.Column="2"  Grid.ColumnSpan="2" Grid.RowSpan="2" Margin="-100,0,0,0" Style="{StaticResource MaterialDesignHeaderedContentControl}" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <!--<Label FontSize="15">ABCD</Label>-->
                            <!--<Label FontSize="15" Grid.Column="3">DCBA</Label>-->
                            <RadioButton x:Name="rbStripUP" Grid.Column="4"/>
                            <!--<materialDesign:PackIcon Grid.Column="5" Kind="ArrowUpBold" Width="20" Height="20"/>-->
                            <RadioButton x:Name="rbStripDown" Grid.Column="1"/>
                            <Image Source="Images/ABCD.png" Height="100"/>
                            <Image Source="Images/DCBA.png" Grid.Column="3" Height="100"/>
                            <!--<materialDesign:PackIcon Grid.Column="2" Kind="ArrowDownBold" Width="20" Height="20"/>-->
                        </Grid>
                    </GroupBox>
                    <GroupBox Visibility="Hidden" Grid.Row="9" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource MaterialDesignHeaderedContentControl}" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="rbMarkingLeft"  FontSize="16" Content="좌측"/>
                            <RadioButton x:Name="rbMarkingRight" FontSize="16" Grid.Column="1" Content="우측"/>
                        </Grid>
                    </GroupBox>
                    <StackPanel x:Name="spUnRe" Grid.Row="9" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label Content="언코일러" FontSize="16"/>
                        <Separator Height="5" Style="{StaticResource MaterialDesignLightSeparator}"/>
                        <Label Content="리코일러" FontSize="16"/>
                    </StackPanel>
                    <StackPanel x:Name="spUnReTS" Grid.Row="9" Grid.Column="2">
                        <ToggleSwitch:HorizontalToggleSwitch Width="75" Height="30" UncheckedContent="역방향" CheckedContent="정방향" x:Name="tsUncoilDirection" Grid.Row="0" HorizontalAlignment="Center" IsChecked="True" Style="{StaticResource iOS5ToggleSwitchStyle}" PreviewMouseDown="tsUncoilDirection_Click"/>
                        <Separator Height="5" Style="{StaticResource MaterialDesignLightSeparator}"/>
                        <ToggleSwitch:HorizontalToggleSwitch Width="75" Height="30" UncheckedContent="역방향" CheckedContent="정방향" x:Name="tsRecoilDirection" Grid.Row="0" HorizontalAlignment="Center" IsChecked="True" Style="{StaticResource iOS5ToggleSwitchStyle}" PreviewMouseDown="tsRecoilDirection_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</mah:MetroWindow>
