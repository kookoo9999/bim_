                <Label Grid.Column="3" Grid.Row="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="13" Content="Y :"/>
                <Label Grid.Column="1" Grid.Row="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="13" Content="M :"/>
                <Label Grid.Column="3" Grid.Row="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="13" Content="A :"/>
                <Label x:Name="lblOffsetXFirst_top" Grid.Column="2" Grid.Row="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" FontSize="15" Content="0"/>
                <Label x:Name="lblOffsetYFirst_top" Grid.Column="4" Grid.Row="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" FontSize="15" Content="0"/>
                <Label x:Name="lblMatchFirst_top" Grid.Column="2" Grid.Row="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" FontSize="15" Content="0"/>
                <!--<Label x:Name="lblAngle1" Grid.Column="4" Grid.Row="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" FontSize="15" Content="0"/>-->
                <Button x:Name="btnInspectAlignFirst_top" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="2" Grid.RowSpan="2" Margin="5" FontSize="20" Content="Align 확인"/>
                <!--<ComboBox Name="cbPos1" SelectedIndex="0" Visibility="Hidden">
                    <ComboBoxItem Content="Right"/>
                    <ComboBoxItem Content="Left"/>
                </ComboBox>-->
            </Grid>
