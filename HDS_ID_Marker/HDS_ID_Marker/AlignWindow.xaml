            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" FontSize="20" Margin="3" Name="btnAlign_top">Align</Button>
            <Button Grid.Column="1" FontSize="20" Margin="3" Name="btnMarking_top">마킹 상부</Button>
            <!--<Button Grid.Column="2" FontSize="20" Margin="3" Name="btnLight">조명</Button>
