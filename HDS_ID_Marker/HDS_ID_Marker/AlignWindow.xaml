                <StackPanel Name="Pan_AOIMark" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Visibility="Visible">
                    <Label FontSize="15" HorizontalAlignment="Left" Width="80">AOI Mark</Label>
                    <TextBox FontSize="15" Width="200" Name="txtAOIMark" Margin="0,3">인식오류</TextBox>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Grid.ColumnSpan="1" Width="437" Height="350">
            <Border BorderThickness="2" BorderBrush="Black" Width="437" Height="350">
                <Canvas Grid.Row="0" Grid.RowSpan="3" x:Name="Livecanvas_top" Width="437" Height="350" Background="Black">
                    <Line StrokeThickness="2" X1="218" X2="218" Y1="0" Y2="350" Stroke="Red"/>
                    <Line StrokeThickness="2" X1="0" X2="437" Y1="175" Y2="175" Stroke="Red"/>
                    <Rectangle Name="rctAlign_top_1" Width="40" Height="40" Stroke="#FF2646D6" StrokeThickness="3"/>
                    <Rectangle Name="rctMark_top" Width="28" Height="28" Stroke="Red" StrokeThickness="3" Canvas.Left="40" Canvas.Top="40"/>
                    <Rectangle Name="rctAoi" Width="300" Height="100" Stroke="Yellow" StrokeThickness="3" Visibility="Visible"/>
                    <Image Grid.Row="0" Grid.RowSpan="3" x:Name="cam_viewer_top" Stretch="Fill" OpacityMask="#D6F0F0F0" Width="437" Height="350" />
                </Canvas>
            </Border>
            <StackPanel/>
            <StackPanel>
                <Button Name="btnAlignROI_top" Width="100" Height="40" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5" FontSize="15" Visibility="Visible">ALIGN SET</Button>
                <Button Name="btnMarkROI_top" Width="100" Height="40" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5" FontSize="15" Visibility="Visible">MARK SET</Button>
                <Button Name="btnAOIROI" Width="100" Height="40" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5" FontSize="15" Visibility="Hidden">AOI SET</Button>
            </StackPanel>
        </Grid>

