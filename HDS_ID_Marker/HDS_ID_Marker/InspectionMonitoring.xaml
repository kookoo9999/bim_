<UserControl x:Class="HDS_ID_Marker.InspectionMonitoring"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HDS_ID_Marker"
             xmlns:subcontrol="clr-namespace:HDS_ID_Marker.SubControl"
             mc:Ignorable="d" 
             d:DesignHeight="980" d:DesignWidth="1900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="512"/>
            <ColumnDefinition Width="470"/>
            <ColumnDefinition Width="470"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="410"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="370"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="DarkGray" BorderThickness="3" CornerRadius="6" Grid.Column="1" Grid.Row="0" Grid.RowSpan="1"/>
        <Border BorderBrush="DarkGray" BorderThickness="3" CornerRadius="6" Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="2" />

        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FF6E6E6E" BorderThickness="2" CornerRadius="5,5,5,5" BorderBrush="LightGray" />
            <Border Grid.Column="2" Background="#FF6E6E6E" BorderThickness="2" CornerRadius="5,5,5,5" BorderBrush="LightGray" />
            <TextBlock Grid.Column="0" Width="25" Text="얼라인" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Foreground="White"/>
            <TextBlock Grid.Column="2" Width="25" Text="2D " FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Foreground="White"/>

            <Border Grid.Column="1" Margin="1" Background="White" BorderBrush="LightGray" BorderThickness="2"/>
            <Border Grid.Column="3" Margin="1" Background="White" BorderBrush="LightGray" BorderThickness="2"/>
            <Image Grid.Column="1" Name="imgAlign" Margin="3"/>
            <Image Grid.Column="3" Name="imgBarcode" Margin="3"/>
        </Grid>

        <Grid Grid.Column="2" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderThickness="2" CornerRadius="5,5,5,5" BorderBrush="DarkGray" />
            <Border Grid.Row="1" Background="White" BorderThickness="2" CornerRadius="5,5,5,5" BorderBrush="DarkGray" />
            <Label Name="lblStatusTop" Grid.Row="0" Content="Align Top : Align 대기" FontSize="20" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="1,-6" Foreground="Black"/>
            <Label Name="lblStatusBot" Grid.Row="1" Content="Align Bot : Align 대기" FontSize="20" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="1,-6" Foreground="Black"/>
        </Grid>


        <subcontrol:ImageViewer Grid.Column="1" Grid.Row="0" Grid.RowSpan="1" x:Name="Viewer_top"/>
        <subcontrol:ImageViewer Grid.Column="2" Grid.Row="0" Grid.RowSpan="1" x:Name="Viewer_bot"/>
        <subcontrol:ResultTable Grid.Column="3" Grid.Row="0" x:Name="ResultTable"/>
        <!--<subcontrol:ControlPanel Grid.Column="3" Grid.Row="1" x:Name="ControlPanel"/>-->
        <subcontrol:ModelTable Grid.Column="4" Grid.Row="0" Grid.RowSpan="2" x:Name="ModelTable"/>
        <subcontrol:LaserTable Grid.Column="3" Grid.Row="1"  x:Name="LaserTable"/>

    </Grid>
</UserControl>
