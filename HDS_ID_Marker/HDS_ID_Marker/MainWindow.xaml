<Window   x:Class="HDS_ID_Marker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDS_ID_Marker" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        WindowStyle="None" ResizeMode="NoResize"
        HorizontalAlignment="Center" VerticalAlignment="Center"        
        mc:Ignorable="d" FontFamily="Roboto" Title="Haesung DS BGA RtR ID Marker M/C version 2.0.6 [2026.04.07] [통합 버전]"
        Icon="images/ID_Matrix.png" d:DesignHeight="1080" d:DesignWidth="1920" KeyDown="Window_KeyDown" ContentRendered="Window_ContentRendered">

    <materialDesign:DialogHost x:Name="dlgExit" Style="{StaticResource MaterialDesignMJDialogHost}"
                DialogClosing="ExitApplication"
                DialogMargin="8">
        <materialDesign:DialogHost.DialogContent>
            <StackPanel Margin="10">
                <TextBlock FontFamily="THE정고딕140" Text="프로그램을 종료하시겠습니까?" FontWeight="ExtraLight" Margin="15 25 15 25" FontSize="20" Foreground="Red"></TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button FontFamily="THE정고딕140" FontSize="20" Style="{StaticResource MaterialDesignFlatButton}" IsDefault="True" Margin="0 8 8 0" Command="materialDesign:DialogHost.CloseDialogCommand">
                        <Button.CommandParameter>
                            <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                True
                            </system:Boolean>
                        </Button.CommandParameter>
                        종료
                    </Button>
                    <Button FontFamily="THE정고딕140" FontSize="20" Style="{StaticResource MaterialDesignFlatButton}" IsCancel="True" Margin="0 8 8 0" Command="materialDesign:DialogHost.CloseDialogCommand">
                        <Button.CommandParameter>
                            <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                                False
                            </system:Boolean>
                        </Button.CommandParameter>
                        취소
                    </Button>
                </StackPanel>
            </StackPanel>
        </materialDesign:DialogHost.DialogContent>
        <Grid Name="gridMain">

            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="3"/>
                <RowDefinition x:Name="rowMainControl" Height="1*"/>
                <RowDefinition x:Name="rowWorkInfoViewer" Height="1*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="Overlay" Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="1000" Visibility="Hidden">
                <Grid.Background>
                    <SolidColorBrush Color="Black" Opacity="0.5"/>
                </Grid.Background>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="510"/>
                    <ColumnDefinition Width="470"/>
                    <ColumnDefinition Width="470"/>
                    <ColumnDefinition Width="470*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="imgCI" Grid.Column="1" Grid.Row="0" Source="Images/CI.PNG" Opacity="1" Margin="0"/>
                <local:MainToolBar x:Name="MainToolBarCtrl" Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" Grid.ColumnSpan="4"/>
                <Button Grid.Column="1" Visibility="Visible" Content="TEST" x:Name="btntestShift" HorizontalAlignment="Left" Margin="460,59,0,0" VerticalAlignment="Top"/>
            </Grid>

            <Grid Grid.Row="3">
                <local:MainControl x:Name="mainControl" Grid.ColumnSpan="2" Visibility="Visible"/>
                <local:MainControlViewer x:Name="mainControlViewer" Grid.ColumnSpan="2" Visibility="Hidden"/>
            </Grid>

            <Grid Grid.Row="4">
                <materialDesign:Transitioner x:Name="tsMain" SelectedIndex="0" AutoApplyTransitionOrigins="True">
                    <materialDesign:Transitioner.InputBindings>
                        <KeyBinding Key="Left" Command="{x:Static materialDesign:Transitioner.MovePreviousCommand}"/>
                        <KeyBinding Key="Right" Command="{x:Static materialDesign:Transitioner.MoveNextCommand}"/>
                    </materialDesign:Transitioner.InputBindings>
                    <materialDesign:TransitionerSlide OpeningEffect="{materialDesign:TransitionEffect FadeIn}" >
                        <Grid>
                            <local:WorkInfoViewer x:Name="workInfoViewer"></local:WorkInfoViewer>
                        </Grid>
                    </materialDesign:TransitionerSlide>
                    <Grid>
                        <local:WorkSettingControl x:Name="workSettingControl"></local:WorkSettingControl>
                    </Grid>
                </materialDesign:Transitioner>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
