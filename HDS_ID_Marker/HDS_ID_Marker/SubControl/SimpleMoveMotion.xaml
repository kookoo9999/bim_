<Window x:Class="HDS_ID_Marker.SubControl.SimpleMoveMotion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDS_ID_Marker.SubControl" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" WindowStyle="None" WindowStartupLocation="CenterScreen"
        mc:Ignorable="d" FontFamily="Roboto" BorderThickness="1" BorderBrush="Gray" AllowsTransparency="True"
        Title="SimpleMoveMotion" Height="600" Width="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Image Grid.Column="0" Grid.Row="0" Source="../images/onlyStrip.png"></Image>
        <Image Grid.Column="0" Grid.Row="1" Source="../images/onlyStrip.png"></Image>
        <Image Grid.Column="0" Grid.Row="2" Source="../images/onlyStrip.png"></Image>
        <Image Grid.Column="0" Grid.Row="3" Source="../images/onlyStrip.png"></Image>

        <Button Width="32" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Button_Click">
            <materialDesign:PackIcon Margin="-7 0 -7 0" Kind="PresenceExit" Width="15" Height="15" Foreground="White"/>
        </Button>
        <Button Grid.Row="0" Name="btn1Row" Height="35" Margin="86,58,302,57" Foreground="White" FontSize="15" Click="btn1Row_Click">상 부 이 동</Button>
        <Button Grid.Row="1" Name="btn2Row" Height="35" Margin="86,58,302,57" Foreground="White" FontSize="15" Click="btn2Row_Click">상 부 이 동</Button>
        <Button Grid.Row="2" Name="btn3Row" Height="35" Margin="86,58,302,57" Foreground="White" FontSize="15" Click="btn3Row_Click">상 부 이 동</Button>
        <Button Grid.Row="3" Name="btn4Row" Height="35" Margin="86,58,302,57" Foreground="White" FontSize="15" Click="btn4Row_Click">상 부 이 동</Button>
        <Button Grid.Row="0" x:Name="btn1RowBot" Height="35" Margin="302,58,86,57" Foreground="White" FontSize="15" Click="btn1RowBot_Click" Content="하 부 이 동"/>
        <Button Grid.Row="1" x:Name="btn2RowBot" Height="35" Margin="302,58,86,57" Foreground="White" FontSize="15" Click="btn2RowBot_Click" Content="하 부 이 동"/>
        <Button Grid.Row="2" x:Name="btn3RowBot" Height="35" Margin="302,58,86,57" Foreground="White" FontSize="15" Click="btn3RowBot_Click" Content="하 부 이 동"/>
        <Button Grid.Row="3" x:Name="btn4RowBot" Height="35" Margin="302,58,86,57" Foreground="White" FontSize="15" Click="btn4RowBot_Click" Content="하 부 이 동"/>


    </Grid>
</Window>
