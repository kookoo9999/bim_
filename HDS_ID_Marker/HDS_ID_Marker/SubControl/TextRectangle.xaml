<UserControl x:Class="HDS_ID_Marker.SubControl.TextRectangle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HDS_ID_Marker.SubControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <TextBlock x:Name="text" FontSize="8" Margin="0,-10,0,0" HorizontalAlignment="Left" FontFamily="굴림"></TextBlock>
        <Rectangle x:Name="rectangle" StrokeThickness="1"></Rectangle>
    </Grid>
</UserControl>
