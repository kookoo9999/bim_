<UserControl x:Class="HDS_ID_Marker.WorkSettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:gif="http://wpfanimatedgif.codeplex.com"
             mc:Ignorable="d"  FontFamily="Roboto"
             d:DesignHeight="475" d:DesignWidth="1900">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Background="White" Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SimpleTextBox}" FontSize="25" Grid.Column="1" Margin="3" x:Name="tbMoveDistance" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Label Grid.Column="2" Content="mm" FontSize="25" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
                    <Button x:Name="btnFeedingMoveLeft" Grid.Column="0" Style="{StaticResource MaterialDesignRaisedDarkButton}" Height="50" Width="90" materialDesign:ButtonAssist.CornerRadius="25" ToolTip="Reel 이동" Click="btnFeedingMoveLeft_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="-4 0 0 0" Kind="ArrowLeftBold" Width="40" Height="40"/>
                            <TextBlock Margin="0 0 0 0" VerticalAlignment="Center" FontSize="20"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnFeedingMoveRight" Grid.Column="3" Style="{StaticResource MaterialDesignRaisedDarkButton}" Height="50" Width="90" materialDesign:ButtonAssist.CornerRadius="25" ToolTip="Align 테스트" Click="btnFeedingMoveRight_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="-4 0 0 0" Kind="ArrowRightBold" Width="40" Height="40"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Column="1" Background="#e5e5e5" Width="1" VerticalAlignment="Stretch" SnapsToDevicePixels="True" />

                <Grid Grid.Column="6">

                    <Grid Grid.Column="0" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.RowSpan="2" VerticalAlignment="Center">
                                <Button x:Name="btnAlignLight" Width="28" Height="28" Foreground="Transparent" Background="Transparent" Padding="0" BorderThickness="0" ToolTip="On/Off"
                                        materialDesign:RippleAssist.Feedback="Gray" Cursor="Hand">
                                    <Image x:Name="imgBtnAlignLight" Source="../Images/Light2.png"/>
                                </Button>
                                <Label Grid.RowSpan="2" Content="Align" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button  Name="btnSaveLightAlign" Grid.Column="3" Padding="0" FontSize="12" Foreground="White" >저장</Button>
                            <Slider Name="sldrLightAlign" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="10,0,10,0"  VerticalAlignment="Center" IsSnapToTickEnabled="True" Interval="1" Maximum="255" Minimum="0" Orientation="Horizontal" TickFrequency="10"  Value="0" Delay="100" SmallChange="1" LargeChange="5"/>
                            <controls:NumericUpDown Margin="3 18 3 18" Grid.Column="2" Minimum="0" Maximum="255" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Padding="0 0 0 0"
                            x:Name="nudLightAlign" Value="{Binding Value, ElementName=sldrLightAlign, Mode=OneWay}" Tag="1"/>
                        </Grid>
                    </Grid>
                    
                </Grid>

                <Border Grid.Column="3" Background="#e5e5e5" Width="1" VerticalAlignment="Stretch" SnapsToDevicePixels="True" />

                <Grid Grid.Column="4">
                    <Grid Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.RowSpan="2" VerticalAlignment="Center">
                                <Image Source="../Images/Light2.png" Width="28" Height="28"/>
                                <Label Grid.RowSpan="2" Content="상면" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button  Name="btnSaveLightTop" Grid.Column="3" Padding="0"  FontSize="12" Foreground="White" >저장</Button>
                            <Slider Name="sldrLightTop" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="10,0,10,0"  VerticalAlignment="Center" IsSnapToTickEnabled="True" Interval="1" Maximum="255" Minimum="0" Orientation="Horizontal" TickFrequency="10"  Value="0" Delay="100" SmallChange="1" LargeChange="5"/>
                            <controls:NumericUpDown Margin="3 18 3 18" Grid.Column="2" Minimum="0" Maximum="255" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Padding="0 0 0 0"
                            x:Name="nudLightTop" Value="{Binding Value, ElementName=sldrLightTop, Mode=OneWay}" Tag="1"/>
                        </Grid>
                    </Grid>


                </Grid>

                <Border Grid.Column="5" Background="#e5e5e5" Width="1" VerticalAlignment="Stretch" SnapsToDevicePixels="True" />
                
                <Grid Grid.Column="8">
                    <Grid Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.RowSpan="2" VerticalAlignment="Center">
                                <Image Source="../Images/Light2.png" Width="28" Height="28"/>
                                <Label Grid.RowSpan="2" Content="하면" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button  Name="btnSaveLightBot" Grid.Column="3"  Padding="0" FontSize="12" Foreground="White" >저장</Button>
                            <Slider Name="sldrLightBot" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="10,0,10,0"  VerticalAlignment="Center" IsSnapToTickEnabled="True" Interval="1" Maximum="255" Minimum="0" Orientation="Horizontal" TickFrequency="10"  Value="0" Delay="100" SmallChange="1" LargeChange="5"/>
                            <controls:NumericUpDown Margin="3 18 3 18" Grid.Column="2" Minimum="0" Maximum="255" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Padding="0 0 0 0"
                            x:Name="nudLightBot" Value="{Binding Value, ElementName=sldrLightBot, Mode=OneWay}" Tag="1"/>
                        </Grid>
                    </Grid>
                </Grid>

                <Border Grid.Column="7" Background="#e5e5e5" Width="1" VerticalAlignment="Stretch" SnapsToDevicePixels="True" />
                
                <Grid Grid.Column="0">
                    <Grid Background="white">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.RowSpan="2" VerticalAlignment="Center">
                            <Button x:Name="btnIDLightOnoff" Width="28" Height="28" Style="{StaticResource MaterialDesignIconButton}" Click="btnIDLightOnoff_Click" >
                                <Image Source="../Images/Light2.png" Width="28" Height="28"/>
                            </Button>
                            
                            <Label Grid.RowSpan="2" Content="ID" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Slider Name="sldrLightID" Grid.Column="1" HorizontalAlignment="Stretch" Margin="10,0,10,0"  VerticalAlignment="Center" IsSnapToTickEnabled="True" Interval="1" Maximum="255" Minimum="0" Orientation="Horizontal" TickFrequency="10"  Value="0" Delay="100" SmallChange="1" LargeChange="5"/>
                        <controls:NumericUpDown Margin="3 18 3 18" Grid.Column="2" Minimum="0" Maximum="255" 
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Padding="0 0 0 0"
                                Name="nudLightID" Value="{Binding ElementName=sldrLightID, Path=Value, Mode=OneWay}" Tag="1"></controls:NumericUpDown>
                        <Button  Name="btnSaveLightID" Grid.Column="3" Padding="0"  FontSize="12" Foreground="White" >저장</Button>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="7*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Margin="2">
                        <materialDesign:ColorZone
                                Mode="Custom"
                                Background="#4c7eb6"
                                CornerRadius="3"
                                materialDesign:ShadowAssist.ShadowDepth="Depth2">
                            <Label  Foreground="White" FontSize="23" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">마킹 위치 보정</Label>
                        </materialDesign:ColorZone>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Label Grid.Column="0" Content="상부" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox Style="{StaticResource SimpleTextBox}" FontSize="25" Grid.Column="1" Margin="15" x:Name="tbTopMotionOffset" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button x:Name="btnTopMarkOffset" Grid.Column="2" Style="{StaticResource MaterialDesignRaisedDarkButton}"  Height="40" Width="80" materialDesign:ButtonAssist.CornerRadius="25" ToolTip="Top 마킹 위치 이동" Click="btnTopMarkOffset_Click" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="-5 0 -5 0">
                                <materialDesign:PackIcon Margin="-4 0 3 0" Kind="MoveToInbox" Width="25" Height="25"/>
                                <TextBlock Margin="0 0 0 0" VerticalAlignment="Center" Text="보정" FontSize="17"/>
                            </StackPanel>
                        </Button>

                        <Label Grid.Column="0" Grid.Row="1" Content="하부" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox Style="{StaticResource SimpleTextBox}" FontSize="25" Grid.Column="1" Grid.Row="1" Margin="15" x:Name="tbBotMotionOffset" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button x:Name="btnBotMarkOffset" Grid.Column="2" Grid.Row="1" Style="{StaticResource MaterialDesignRaisedDarkButton}"  Height="40" Width="80" materialDesign:ButtonAssist.CornerRadius="25" ToolTip="Top 마킹 위치 이동" Click="btnBotMarkOffset_Click">
                            <StackPanel Orientation="Horizontal" Margin="-5 0 -5 0">
                                <materialDesign:PackIcon Margin="-4 0 3 0" Kind="MoveToInbox" Width="25" Height="25"/>
                                <TextBlock Margin="0 0 0 0" VerticalAlignment="Center" Text="보정" FontSize="17"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!--<Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Button x:Name="btnTopMarkTest" Grid.Column="0" Style="{StaticResource MaterialDesignRaisedDarkButton}" Height="60" Width="230" materialDesign:ButtonAssist.CornerRadius="25" ToolTip="Top 마킹 시작">
                            <StackPanel Orientation="Horizontal" Margin="-5 0 -5 0">
                                <materialDesign:PackIcon Margin="0 0 4 0" VerticalAlignment="Center" Kind="Marker" Width="25" Height="25"/>
                                <TextBlock Margin="0 0 0 0" VerticalAlignment="Center" Text="상부 마킹 테스트" FontSize="24"/>
                            </StackPanel>
                        </Button>
                        <CheckBox Grid.Column="1" x:Name="cbTopMarkCheck" VerticalAlignment="Center" Content="검사" HorizontalAlignment="Center"/>
                        <Button x:Name="btnBotMarkTest" Grid.Column="0" Grid.Row="1" Style="{StaticResource MaterialDesignRaisedDarkButton}" Height="60" Width="230" materialDesign:ButtonAssist.CornerRadius="25" ToolTip="Top 마킹 시작">
                            <StackPanel Orientation="Horizontal" Margin="-5 0 -5 0">
                                <materialDesign:PackIcon Margin="0 0 4 0" VerticalAlignment="Center" Kind="Marker" Width="25" Height="25"/>
                                <TextBlock Margin="0 0 0 0" VerticalAlignment="Center" Text="하부 마킹 테스트" FontSize="24"/>
                            </StackPanel>
                        </Button>
                        <CheckBox Grid.Column="1" Grid.Row="1" x:Name="cbBotMarkCheck" VerticalAlignment="Center" Content="검사" HorizontalAlignment="Center"/>
                        <Button x:Name="btnAllMarkTest" Grid.Column="0" Grid.Row="2" Style="{StaticResource MaterialDesignRaisedDarkButton}" Height="60" Width="230" materialDesign:ButtonAssist.CornerRadius="25" ToolTip="Top 마킹 시작">
                            <StackPanel Orientation="Horizontal" Margin="-5 0 -5 0">
                                <materialDesign:PackIcon Margin="0 0 4 0" VerticalAlignment="Center" Kind="Marker" Width="25" Height="25"/>
                                <TextBlock Margin="0 0 0 0" VerticalAlignment="Center" Text="전체 마킹 테스트" FontSize="24"/>
                            </StackPanel>
                        </Button>
                        <CheckBox x:Name="cbAllMarkCheck" VerticalAlignment="Center" Content="검사" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="1"/>
                    </Grid>-->
                </Grid>

                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="5*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Margin="2">
                        <materialDesign:ColorZone
                                Mode="Custom"
                                Background="#4c7eb6"
                                CornerRadius="3"
                                materialDesign:ShadowAssist.ShadowDepth="Depth2">
                            <Label  Foreground="White" FontSize="23" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Align</Label>
                        </materialDesign:ColorZone>
                    </Border>
                    <Border Background="#323232" Grid.Column="0" Grid.Row="1" Margin="2">
                        <Grid>
                            <Image x:Name="imgAlign" Grid.Row="1" Grid.Column="1" Stretch="Uniform" Margin="5"/>
                        <Line StrokeThickness="2" X1="30" X2="30" Y1="15" Y2="45" Stroke="Red" Width="60" Height="60" Panel.ZIndex="1"/>
                        <Line StrokeThickness="2" X1="15" X2="45" Y1="30" Y2="30" Stroke="Red" Width="60" Height="60" Panel.ZIndex="1"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" Margin="2,2,2,30" CornerRadius="3" Background="White" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="4*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Label  Grid.Column="0" Foreground="Black" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">X :</Label>
                            <Label  x:Name="lblAlignOffsetX" Grid.Column="1" Foreground="Black" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >0</Label>
                            <Label  Grid.Column="2" Foreground="Black" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Y :</Label>
                            <Label  x:Name="lblAlignOffsetY" Grid.Column="3" Foreground="Black" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >0</Label>
                            <Label  Grid.Column="4" Foreground="Black" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">M:</Label>
                            <Label  x:Name="lblAlignMatch" Grid.Column="5" Foreground="Black" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >0</Label>
                            <Label  Grid.Row="1" Grid.Column="0" Foreground="Black" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">X :</Label>
                            <Label Grid.Row="1"  x:Name="lblAlignOffsetX2" Grid.Column="1" Foreground="Black" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >0</Label>
                            <Label  Grid.Row="1" Grid.Column="2" Foreground="Black" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Y :</Label>
                            <Label  Grid.Row="1" x:Name="lblAlignOffsetY2" Grid.Column="3" Foreground="Black" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >0</Label>
                            <Label Grid.Row="1"  Grid.Column="4" Foreground="Black" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">M:</Label>
                            <Label  Grid.Row="1" x:Name="lblAlignMatch2" Grid.Column="5" Foreground="Black" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >0</Label>

                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="5*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="1" Margin="2">
                        <materialDesign:ColorZone
                                Mode="Custom"
                                Background="#4c7eb6"
                                CornerRadius="3"
                                materialDesign:ShadowAssist.ShadowDepth="Depth2">
                            <Label  Foreground="White" FontSize="24" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Top Mark</Label>
                        </materialDesign:ColorZone>
                    </Border>

                    <Border Background="#323232" Grid.Row="1" Grid.Column="1" Margin="2">
                        <Grid>
                            <Image x:Name="imgTopMark" Stretch="Uniform" Margin="5"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" Margin="1,2,0,30" CornerRadius="3 3 0 0" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <!--<StackPanel Orientation="Horizontal">
                                    <Image Source="../images/OCR.png" Width="40"/>
                                    <Label Content="인식결과" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>-->
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="../images/ID_Matrix.png" Width="40"/>
                                    <Label Content="인식결과" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                    <!--<TextBox
                                        x:Name="tbTopOCRMarkResult"
                                         Style="{StaticResource SimpleTextBox}"
                                         VerticalContentAlignment="Center"
                                         Grid.Column="1"
                                         Margin="3"
                                         materialDesign:HintAssist.Hint="Result of AOI Recognition"
                                         BorderThickness="1"
                                         Height="30"
                                         VerticalAlignment="Center" />-->

                                    <TextBox
                                        x:Name="tbTopMatrixMarkResult"
                                         Style="{StaticResource SimpleTextBox}"
                                         VerticalContentAlignment="Center"
                                         Grid.Column="1"
                                         Margin="3"
                                         materialDesign:HintAssist.Hint="Result of AOI Recognition"
                                         BorderThickness="1"
                                         Height="30"
                                         VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Border>

                </Grid>

                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="5*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Margin="2">
                        <materialDesign:ColorZone
                                Mode="Custom"
                                Background="#4c7eb6"
                                CornerRadius="3"
                                materialDesign:ShadowAssist.ShadowDepth="Depth2">
                            <Label  Foreground="White" FontSize="24" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Bot Mark</Label>
                        </materialDesign:ColorZone>
                    </Border>


                    <Border Background="#323232" Grid.Row="1" Margin="2">
                        <Grid>
                            <Image x:Name="imgBotMark" Grid.Row="1" Grid.Column="0" Stretch="Uniform" Margin="5"/>
                        </Grid>
                    </Border>


                    <Border Grid.Row="2" Grid.Column="0" Margin="1,2,0,30" CornerRadius="3 3 0 0" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <!--<StackPanel Orientation="Horizontal">
                                    <Image Source="../images/OCR.png" Width="40"/>
                                    <Label Content="인식결과" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>-->
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="../images/ID_Matrix.png" Width="40"/>
                                    <Label Content="인식결과" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                    <!--<TextBox
                                        x:Name="tbBotOCRMarkResult"
                                         Style="{StaticResource SimpleTextBox}"
                                         VerticalContentAlignment="Center"
                                         Grid.Column="1"
                                         Margin="3"
                                         materialDesign:HintAssist.Hint="Result of AOI Recognition"
                                         BorderThickness="1"
                                         Height="30"
                                         VerticalAlignment="Center" />-->
                                    <TextBox
                                        x:Name="tbBotMatrixMarkResult"
                                         Style="{StaticResource SimpleTextBox}"
                                         VerticalContentAlignment="Center"
                                         Grid.Column="1"
                                         Margin="3"
                                         materialDesign:HintAssist.Hint="Result of AOI Recognition"
                                         BorderThickness="1"
                                         Height="30"
                                         VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="5*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="2">
                        <materialDesign:ColorZone
                                Mode="Custom"
                                Background="#4c7eb6"
                                CornerRadius="3"
                                materialDesign:ShadowAssist.ShadowDepth="Depth2">
                            <Label  Foreground="White" FontSize="24" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">AOI 2D</Label>
                        </materialDesign:ColorZone>
                    </Border>
                    
                    <Border Background="#323232" Grid.Row="1" Margin="2">
                        <Grid>
                            <Image x:Name="imgAOI" Stretch="Uniform" Margin="5"/>
                        <!--<Line StrokeThickness="2" X1="30" X2="30" Y1="15" Y2="45" Stroke="Red" Width="60" Height="60" Panel.ZIndex="1"/>
                        <Line StrokeThickness="2" X1="15" X2="45" Y1="30" Y2="30" Stroke="Red" Width="60" Height="60" Panel.ZIndex="1"/>-->
                        </Grid>
                    </Border>
                    
                    <Border Grid.Row="2" Margin="2,2,2,30" CornerRadius="3" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <Image Source="../images/AOI.png" Width="30"/>
                                <!--<materialDesign:PackIcon Kind="TextRecognition" Height="34" Width="42" HorizontalAlignment="Center" Margin="18,0"/>-->
                                <Label Content="인식결과" HorizontalAlignment="Center" FontWeight="Bold" Margin="11,0"/>
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <TextBox 
                                    x:Name="tbAOIResult"
                                    Style="{StaticResource SimpleTextBox}"
                                         VerticalContentAlignment="Center"
                                         Grid.Column="1"
                                         Margin="8 0 8 0"
                                         materialDesign:HintAssist.Hint="Result of AOI Recognition"
                                         BorderThickness="1"
                                         Height="30"
                                         VerticalAlignment="Center" />
                            </Grid>

                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
