<UserControl x:Class="HDS_ID_Marker.SubControl.ModelTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HDS_ID_Marker"
             mc:Ignorable="d" 
             d:DesignHeight="610" d:DesignWidth="458">
    <Grid Name="model_table" DataContext="{Binding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="101"/>
                <RowDefinition Height="101"/>
                <RowDefinition Height="101"/>
                <RowDefinition Height="101"/>
                <RowDefinition Height="101"/>
                <RowDefinition Height="101*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,1" CornerRadius="7" >
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                <RotateTransform Angle="90" CenterY="0.5" CenterX="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FFBDBDBD" Offset="0"/>
                        <GradientStop Color="#FFEFE9F1" Offset="0.709"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,1" CornerRadius="7" >
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                <RotateTransform Angle="90" CenterY="0.5" CenterX="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FFBDBDBD" Offset="0"/>
                        <GradientStop Color="#FFEFE9F1" Offset="0.709"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,1" CornerRadius="7" >
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                <RotateTransform Angle="90" CenterY="0.5" CenterX="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FFBDBDBD" Offset="0"/>
                        <GradientStop Color="#FFEFE9F1" Offset="0.709"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,1" CornerRadius="7" >
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                <RotateTransform Angle="90" CenterY="0.5" CenterX="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FFBDBDBD" Offset="0"/>
                        <GradientStop Color="#FFEFE9F1" Offset="0.709"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,1" CornerRadius="7" >
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                <RotateTransform Angle="90" CenterY="0.5" CenterX="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FFBDBDBD" Offset="0"/>
                        <GradientStop Color="#FFEFE9F1" Offset="0.709"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,1" CornerRadius="7" >
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                <RotateTransform Angle="90" CenterY="0.5" CenterX="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FFBDBDBD" Offset="0"/>
                        <GradientStop Color="#FFEFE9F1" Offset="0.709"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Grid.Row="0" Grid.Column="0" Margin="0,1" CornerRadius="8,0,0,8" Background="Gray" />
            <Border Grid.Row="1" Grid.Column="0" Margin="0,1" CornerRadius="8,0,0,8" Background="Gray" />
            <Border Grid.Row="2" Grid.Column="0" Margin="0,1" CornerRadius="8,0,0,8" Background="Gray" />
            <Border Grid.Row="3" Grid.Column="0" Margin="0,1" CornerRadius="8,0,0,8" Background="Gray" />
            <Border Grid.Row="4" Grid.Column="0" Margin="0,1" CornerRadius="8,0,0,8" Background="Gray" />
            <Border Grid.Row="5" Grid.Column="0" Margin="0,1" CornerRadius="8,0,0,8" Background="Gray" />

            <Label Grid.Row="0" Content="모 델" FontSize="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Foreground="White" FontFamily="HY부활L" FontWeight="Bold" HorizontalAlignment="Center"/>
            <Label Grid.Row="1" Content="로 트" FontSize="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Foreground="White" FontFamily="HY부활L" FontWeight="Bold" HorizontalAlignment="Center"/>
            <Label Grid.Row="2" Content="시작시간"  FontSize="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Foreground="White" FontFamily="HY부활L" FontWeight="Bold" HorizontalAlignment="Center"/>
            <Label Grid.Row="3" Content="경과시간" FontSize="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Foreground="White" FontFamily="HY부활L" FontWeight="Bold" HorizontalAlignment="Center"/>
            <Label Grid.Row="4" Content="투입 &#xd;Strip" FontSize="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Foreground="White" FontFamily="HY부활L" FontWeight="Bold" HorizontalAlignment="Center"/>
            <Label Grid.Row="5" Content="투입 &#xd;Panel" FontSize="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Foreground="White" FontFamily="HY부활L" FontWeight="Bold" HorizontalAlignment="Center"/>

            <TextBlock Name="txtModel" Grid.Column="2" Grid.Row="0"  FontSize="35" VerticalAlignment="Center" HorizontalAlignment="Center"  Margin="1" Foreground="Black" FontWeight="Bold"/>
            <TextBlock Name="txtLotNumber" Grid.Column="2" Grid.Row="1"  FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"  Margin="1" Foreground="Black" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock Name="txtStratTime" Text="{Binding Path=StartTime, StringFormat='yy-MM-dd HH:mm:ss'}" Grid.Column="1" Grid.Row="2"  FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1" Foreground="Black" FontWeight="Bold"/>
            <TextBlock Name="txtRunTime" Text="{Binding Path=RunTime, StringFormat=hh\\:mm\\:ss, TargetNullValue= ' --- '}" Grid.Column="1" Grid.Row="3"  FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1" Foreground="Black" FontWeight="Bold"/>

            <TextBlock Name="txtStripCount" Grid.Column="2" Grid.Row="4" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1" Foreground="Black" FontWeight="Bold" Text="{Binding Path=InspectStrip}"/>
            <TextBlock Name="txtPanelCount" Grid.Column="2" Grid.Row="5" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1" Foreground="Black" FontWeight="Bold" Text="{Binding Path=InspectPanel}"/>

        </Grid>
        
    </Grid>
</UserControl>
