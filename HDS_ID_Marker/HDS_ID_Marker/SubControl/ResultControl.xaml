<UserControl x:Class="HDS_ID_Marker.ResultControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" FontFamily="Roboto"
             d:DesignHeight="308" d:DesignWidth="471">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="2">
            <materialDesign:ColorZone
                                Mode="Custom"
                                Background="#8b6e60"
                                CornerRadius="3"
                                materialDesign:ShadowAssist.ShadowDepth="Depth2">
                <Label  Foreground="White" FontSize="23" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Align</Label>
            </materialDesign:ColorZone>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Margin="2">
            <materialDesign:ColorZone
                                Mode="Custom"
                                Background="#8b6e60"
                                CornerRadius="3"
                                materialDesign:ShadowAssist.ShadowDepth="Depth2">
                <Label  Foreground="White" FontSize="23" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Mark</Label>
            </materialDesign:ColorZone>
        </Border>

        <Border Background="#323232" Grid.Row="1" Margin="5">
            <Image x:Name="imgAlign" Grid.Row="1" Grid.Column="0" Stretch="Fill" Margin="5"/>
        </Border>
        <Border Background="#323232" Grid.Column="1" Grid.Row="1" Margin="5">
            <Image x:Name="imgMark" Grid.Row="1" Grid.Column="1" Stretch="Fill" Margin="5"/>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="2" CornerRadius="3" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Label  Grid.Column="1" Foreground="Black" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">X :</Label>
                <Label  x:Name="lblOffsetX" Grid.Column="2" Foreground="Black" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0 0 40 0">0.11</Label>
                <Label  Grid.Row="1" Grid.Column="1" Foreground="Black" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Y :</Label>
                <Label  x:Name="lblOffsetY" Grid.Row="1" Grid.Column="2" Foreground="Black" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0 0 40 0">0.21</Label>
                <Label  Grid.Column="4" Foreground="Black" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">M:</Label>
                <Label  x:Name="lblMatch" Grid.Column="5" Foreground="Black" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0 0 40 0">0.99%</Label>

            </Grid>
        </Border>
    </Grid>
</UserControl>
