<UserControl x:Class="HDS_ID_Marker.SubControl.LaserTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HDS_ID_Marker"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="470">
    <Grid Name="laser_table">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>         
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="185"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Margin="0,1" CornerRadius="7" >
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                <RotateTransform Angle="90" CenterY="0.5" CenterX="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FFBDBDBD" Offset="0"/>
                        <GradientStop Color="#FFEFE9F1" Offset="0.709"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Margin="0,1" CornerRadius="7" >
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                <RotateTransform Angle="90" CenterY="0.5" CenterX="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FFBDBDBD" Offset="0"/>
                        <GradientStop Color="#FFEFE9F1" Offset="0.709"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1" Margin="0,1" CornerRadius="7" >
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                <RotateTransform Angle="90" CenterY="0.5" CenterX="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FFBDBDBD" Offset="0"/>
                        <GradientStop Color="#FFEFE9F1" Offset="0.709"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="1" Margin="0,1" CornerRadius="7" >
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                <RotateTransform Angle="90" CenterY="0.5" CenterX="0.5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FFBDBDBD" Offset="0"/>
                        <GradientStop Color="#FFEFE9F1" Offset="0.709"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
          

            <Border Grid.Row="0" Grid.Column="0" Margin="0,1" CornerRadius="8,0,0,8" Background="Gray" />
            <Border Grid.Row="1" Grid.Column="0" Margin="0,1" CornerRadius="8,0,0,8" Background="Gray" />
            <Border Grid.Row="0" Grid.Column="2" Margin="0,1" CornerRadius="8,0,0,8" Background="Gray" />
            <Border Grid.Row="1" Grid.Column="2" Margin="0,1" CornerRadius="8,0,0,8" Background="Gray" />
            
            <Label Grid.Row="0" Content="X POS" FontSize="13" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Foreground="White" FontFamily="HY부활L" FontWeight="Bold" HorizontalAlignment="Center"  />
            <Label Grid.Row="1" Content="Y POS" FontSize="13" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Foreground="White" FontFamily="HY부활L" FontWeight="Bold" HorizontalAlignment="Center"/>
            <Label Grid.Row="0" Grid.Column="2" FontSize="13" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Foreground="White" FontFamily="HY부활L" FontWeight="Bold" HorizontalAlignment="Center">
                <TextBlock>
                    레이져 <LineBreak/> X POS
                </TextBlock>
            </Label>
            <Label Grid.Row="1" Grid.Column="2" FontSize="13" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Foreground="White" FontFamily="HY부활L" FontWeight="Bold" HorizontalAlignment="Center">
                <TextBlock>
                    레이져 <LineBreak/> Y POS
                </TextBlock>
            </Label>
           
            <TextBlock Name="txtPosX" Grid.Column="1" Grid.Row="0" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1" Foreground="Black" FontWeight="Bold"/>
            <TextBlock Name="txtPosY" Grid.Column="1" Grid.Row="1" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1" Foreground="Black" FontWeight="Bold"/>
            <TextBlock Name="txtLaserX" Grid.Column="3" Grid.Row="0" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1" Foreground="Black" FontWeight="Bold"/>
            <TextBlock Name="txtLaserY" Grid.Column="3" Grid.Row="1" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="1" Foreground="Black" FontWeight="Bold"/>
            

            <!--<local:LedLamp x:Name="lampConnect" Grid.Column="1" HorizontalAlignment="Left" Height="30" Margin="8" Grid.Row="4" VerticalAlignment="Top" Width="30"/>-->
            
        </Grid>
    </Grid>
</UserControl>
   