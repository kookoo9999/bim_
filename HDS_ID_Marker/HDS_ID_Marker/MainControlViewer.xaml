<UserControl x:Class="HDS_ID_Marker.MainControlViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:milwpf ="clr-namespace:Matrox.MatroxImagingLibrary.WPF;assembly=Matrox.MatroxImagingLibrary.WPF" xmlns:ToggleSwitch="clr-namespace:ToggleSwitch;assembly=ToggleSwitch"
             mc:Ignorable="d" FontFamily="Roboto" FontWeight="Bold" FontSize="28"
             d:DesignHeight="550" d:DesignWidth="1900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="14*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3.75*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="3.75*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <ToggleSwitch:HorizontalToggleSwitch PreviewMouseUp ="tsTopLaser_State_Check" Grid.Column="0" Width="95" Height="35" UncheckedContent="상부&#10;레이저꺼짐" CheckedContent="상부&#10;레이저정상" x:Name="tsTopLaser" Grid.Row="0" HorizontalAlignment="Center" IsChecked="False" Style="{StaticResource iOS5ToggleSwitchStyle}"/>
                <ToggleSwitch:HorizontalToggleSwitch PreviewMouseUp ="tsBotLaser_State_Check" Grid.Column="1" Width="95" Height="35" UncheckedContent="하부&#10;레이저꺼짐" CheckedContent="하부&#10;레이저정상" x:Name="tsBotLaser" Grid.Row="0" HorizontalAlignment="Center" IsChecked="False" Style="{StaticResource iOS5ToggleSwitchStyle}"/>

            </Grid>
            <Label Grid.Column="1" FontSize="20" Foreground="White" Background="#4c7eb6"  Content="Align/TOP" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <Border Grid.Column="2" Background="#e5e5e5" Width="1" VerticalAlignment="Stretch" SnapsToDevicePixels="True" />
            <Label  Grid.Column="3" FontSize="20" Foreground="White" Background="#4c7eb6" Content="BOT"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <ToggleSwitch:HorizontalToggleSwitch Checked ="tsAlarm_State_Check" Unchecked="tsAlarm_State_Check" CheckedBackground="Red" Grid.Column="4" Width="85" Height="30" UncheckedContent="알람꺼짐" CheckedContent="알람켜짐" x:Name="tsAlarm" HorizontalAlignment="Left" IsChecked="False" Style="{StaticResource iOS5ToggleSwitchStyle}" Margin="11,2,0,0" VerticalAlignment="Top"/>
            <ToggleSwitch:HorizontalToggleSwitch Checked ="tsVision_State_Check" Unchecked="tsVision_State_Check" CheckedBackground="Red" Grid.Column="4" Width="85" Height="30" UncheckedContent="조명꺼짐" CheckedContent="조명켜짐" x:Name="tsVision_Light" IsChecked="False" Style="{StaticResource iOS5ToggleSwitchStyle}" HorizontalAlignment="Left" Margin="100,0,0,4" VerticalAlignment="Bottom"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3.75*"/>
                <ColumnDefinition Width="3.75*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Width="80" Height="30" Content="100.000" Name="lblAlignPos" Foreground="Red" FontSize="16" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
            <Border Grid.Column="1" BorderThickness="2" BorderBrush="#b2b2b2" Background="Black">
                <Canvas Width=" 746" Height="506"  x:Name="Canvas_Top" Background="Black" ClipToBounds="True">
                    <Line x:Name="topLine1" StrokeThickness="2" X1="373" X2="373" Y1="0" Y2="506" Stroke="Red" Width="746" Height="506" Panel.ZIndex="9"/>
                    <Line x:Name="topLine2" StrokeThickness="2" X1="0" X2="746" Y1="253" Y2="253" Stroke="Red" Width="746" Height="506" Panel.ZIndex="9"/>
                    <milwpf:MILWPFDisplay  x:Name="LiveCamViewer_Top" Width="746" Height="506"/>
                </Canvas>
            </Border>

            <Label Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Width="80" Height="30" Content="100.000" Name="lblTopPos" Foreground="Red" FontSize="16" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
            <Label Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Width="80" Height="30" Content="100.000" Name="lblGripPos" Foreground="Red" FontSize="16" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
            <Border Grid.Column="2" BorderThickness="2" BorderBrush="#b2b2b2" Background="Black">
                <Canvas Width=" 746" Height="506"  x:Name="Canvas_Bot" Background="Black" ClipToBounds="True">
                    <Line x:Name="botLine1" StrokeThickness="2" X1="373" X2="373" Y1="0" Y2="506" Stroke="Red" Width="746" Height="506" Panel.ZIndex="9"/>
                    <Line x:Name="botLine2" StrokeThickness="2" X1="0" X2="746" Y1="253" Y2="253" Stroke="Red" Width="746" Height="506" Panel.ZIndex="9"/>
                    <milwpf:MILWPFDisplay  x:Name="LiveCamViewer_Bot" Width="746" Height="506"/>
                </Canvas>
            </Border>
            <Label Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Width="80" Height="30" Content="100.000" Name="lblBotPos" Foreground="Red" FontSize="16" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />

            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <ToggleSwitch:HorizontalToggleSwitch IsEnabled="False" Width="75" Height="30" UncheckedContent="역방향" CheckedContent="정방향" x:Name="tsRecoilDirection" Grid.Row="0" HorizontalAlignment="Center" IsChecked="True" Style="{StaticResource iOS5ToggleSwitchStyle}"/>
                <Button  Grid.Row="1" Name="btnLeftFeeding" Cursor="Hand" Tag="Marking" Style="{StaticResource MaterialDesignBlueCircleBtn}"
                    Width="100" Height="100" PreviewMouseDown="btnLeftFeeding_PreviewMouseDown" PreviewMouseUp="btnLeftFeeding_PreviewMouseUp">
                    <StackPanel>
                        <materialDesign:PackIcon Name="ImgLeft" Kind="ArrowLeftBold" Width="70" Height="70" HorizontalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button  Grid.Row="2" Name="btnLeftFeedingOnOff" Cursor="Hand" Tag="Marking" Style="{StaticResource MaterialDesignBlueCircleBtn}"
                    Width="100" Height="100" Click="btnLeftFeedingOnOff_Click">
                    <StackPanel>
                        <materialDesign:PackIcon Name="ImgLeftOnOff" Kind="SkipBackward" Width="70" Height="70" HorizontalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <ToggleSwitch:HorizontalToggleSwitch IsEnabled="False" Width="75" Height="30" UncheckedContent="역방향" CheckedContent="정방향" x:Name="tsUncoilDirection" Grid.Row="0" HorizontalAlignment="Center" IsChecked="True" Style="{StaticResource iOS5ToggleSwitchStyle}"/>
                <Button  Grid.Row="1" Name="btnRightFeeding" Cursor="Hand" Tag="Marking" Style="{StaticResource MaterialDesignBlueCircleBtn}"
                    Width="100" Height="100" PreviewMouseDown="btnRightFeeding_PreviewMouseDown" PreviewMouseUp="btnRightFeeding_PreviewMouseUp">
                    <StackPanel>
                        <materialDesign:PackIcon Name="ImgRight" Kind="ArrowRightBold" Width="70" Height="70" HorizontalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button  Grid.Row="2" Name="btnRightFeedingOnOff" Cursor="Hand" Tag="Marking" Style="{StaticResource MaterialDesignBlueCircleBtn}"
                    Width="100" Height="100" Click="btnRightFeedingOnOff_Click">
                    <StackPanel>
                        <materialDesign:PackIcon Name="ImgRightOnOff" Kind="SkipForward" Width="70" Height="70" HorizontalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>

        </Grid>
    </Grid>

</UserControl>
