<Window x:Class="HDS_ID_Marker.SubWindow.TensionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDS_ID_Marker.SubWindow"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Roboto"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Title="수동 텐션 값 입력" Height="300" Width="800" Loaded="Window_Loaded">
    <Grid Background="White" x:Name="gridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.ColumnSpan="3" Background="#4c7eb6">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <Label FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto" FontWeight="Bold" Foreground="White">수동 텐션 값 입력창 입니다. (재시작시 초기화 됩니다.)
                </Label>
                <Label FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto" FontWeight="Bold" Foreground="White">현재 텐션 값을 확인하고, 텐션 값을 수정해 주세요.
                </Label>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="25">
                <TextBlock>현재<LineBreak/>텐션 값 :</TextBlock>
            </Label>
            <TextBlock x:Name="tbCurTensionVal" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Text="0" FontSize="25"></TextBlock>

            <Label Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="25">
                <TextBlock>수정<LineBreak/>텐션 값 :</TextBlock>
            </Label>
            <TextBox x:Name="tbEditTensionVal" Grid.Row="0" Grid.Column="4" Style="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="25" Text="0" Width="50" HorizontalContentAlignment="Center"></TextBox>
            
        </Grid>
        <Grid Grid.Row="2">
            <StackPanel Grid.Row="2" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="btnEnd" Click="btnEnd_Click" Grid.Row="2" Width="160" Height="50" Margin="15, 0" FontSize="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="ExitToApp" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                        <TextBlock FontWeight="Normal" FontSize="24" Text="수 정" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnCancel" Click="btnClose_Click" Grid.Row="3" Width="150" Height="50" Margin="15, 0" FontSize="24" Content="취  소" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
