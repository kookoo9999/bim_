<Window x:Class="HDS_ID_Marker.SubWindow.MCPartControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Roboto" Topmost="True"
        Title="MaterialAlertDlg" Height="600" Width="400" WindowStartupLocation="CenterScreen">
    <Grid>
        <Border BorderThickness="3" CornerRadius="15" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" Direction="-90" RenderingBias="Quality" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="8*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.ColumnSpan="3" Background="#4c7eb6" CornerRadius="13 13 0 0">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <Label x:Name="title" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White">기구 제어
                        </Label>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="15"/>
                        <RowDefinition/>
                        <RowDefinition Height="15"/>
                        <RowDefinition/>
                        <RowDefinition Height="15"/>
                        <RowDefinition/>
                        <RowDefinition Height="15"/>
                        <RowDefinition/>
                        <RowDefinition Height="15"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Button x:Name="btnRollerUp" Click="btnRollerUp_Click" Grid.Column="0" Grid.Row="0" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="누름 롤러 상승">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="Firewire" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="20" Text="롤러 상승" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnRollerDown" Click="btnRollerDown_Click" Grid.Column="2" Grid.Row="0" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="누름 롤러 하강">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="Firewire" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="20" Text="롤러 하강" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnGripOn" Click="btnGripOn_Click" Grid.Column="0" Grid.Row="2" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="그립퍼 그립 on">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="DragHorizontalVariant" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="20" Text="그립 On" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnGripOff" Click="btnGripOff_Click" Grid.Column="2" Grid.Row="2" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="그립퍼 그립 off" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="DragHorizontalVariant" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="20" Text="그립 Off" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnTensionOn" Click="btnTensionOn_Click" Grid.Column="0" Grid.Row="4" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="그립퍼 텐션 on">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="ArrowExpandVertical" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="20" Text="텐션 On" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnTensionOff" Click="btnTensionOff_Click" Grid.Column="2" Grid.Row="4" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="그립퍼 텐션 off" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="ArrowExpandVertical" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="20" Text="텐션 Off" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnGrip" Click="btnGrip_Click" Grid.Column="0" Grid.Row="6" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="그립핑 ">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="NotificationClearAll" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="20" Text="그립핑 On" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnRelease" Click="btnRelease_Click" Grid.Column="2" Grid.Row="6" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="그립퍼 텐션 off" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="NotificationClearAll" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="20" Text="그립핑 Off" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnSuctionOn" Click="btnSuctionOn_Click" Grid.Column="0" Grid.Row="8" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="집진기 on ">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="WeatherWindy" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="20" Text="집진기 On" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnSuctionOff" Click="btnSuctionOff_Click" Grid.Column="2" Grid.Row="8" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="집진기 off" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="WeatherWindy" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="20" Text="집진기 Off" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnCoilerTensionOn" Click="btnCoilerTensionOn_Click" Grid.Column="0" Grid.Row="10" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="Coiler 텐션 on ">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="ArrowExpandHorizontal" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="20" Text="텐션 On" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnCoilerTentionOff" Click="btnCoilerTentionOff_Click" Grid.Column="2" Grid.Row="10" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="Coiler 텐션 off" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="ArrowExpandHorizontal" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="20" Text="텐션 Off" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>

                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Name="btnClose" Width="100" Height="30" FontSize="16" Foreground="white" Click="btnClose_Click">확 인</Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
