<Window x:Class="HDS_ID_Marker.SubWindow.MaterialWarningDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDS_ID_Marker.SubWindow"
        mc:Ignorable="d"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True" Topmost="True"
        Height="200" Width="350" WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight">
    <Border Background="White" BorderThickness="3" CornerRadius="15" x:Name="back">
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" Direction="-90" RenderingBias="Quality" ShadowDepth="1"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Margin="5" Source="../Images/Warning2.png" MaxWidth="65" MaxHeight="65"/>
                <Label/>
                <TextBlock Margin="10" Text="경고" VerticalAlignment="Center" Foreground="Red" FontSize="40"/>
            </StackPanel>
            <TextBlock Margin="10" x:Name="tbMessage" Grid.Row="1" Text="Content" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Height="Auto" Width="Auto"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="10,10,10,10"  VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="THE정고딕140" FontSize="25" Style="{StaticResource MaterialDesignFlatButton}" IsDefault="True" Click="Button_Click">확인</Button>
                <Button Grid.Column="1" Margin="10,10,10,10"  VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="THE정고딕140" FontSize="25" Style="{StaticResource MaterialDesignFlatButton}" IsDefault="True" Click="Button_Click">수정</Button>
            </Grid>
        </Grid>
    </Border>
</Window>
