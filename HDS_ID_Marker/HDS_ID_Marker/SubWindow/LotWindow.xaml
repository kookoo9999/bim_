<Window x:Class="HDS_ID_Marker.SubWindow.LotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDS_ID_Marker"
        mc:Ignorable="d" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Roboto"
        WindowStartupLocation="CenterScreen"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:ToggleSwitch="clr-namespace:ToggleSwitch;assembly=ToggleSwitch"
        Title="Lot 입력" Height="700" Width="500" Loaded="Window_Loaded">
    <Border Background="White">
        <Grid>

            <Grid Grid.Column="0" Width="500" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.ColumnSpan="3" Background="#4c7eb6">
                    <Label FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto" FontWeight="Bold" Foreground="White"
                   Name="lblCaption">Lot 정보를 입력해 주세요.</Label>
                </Border>

                <Label Grid.Column="0" Grid.Row="1" Content="      ITS&#xd;&#xa;Model No" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                <Label Grid.Column="0" Grid.Row="2" Content="   ITS&#xd;&#xa;Lot No" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                <Label Grid.Column="0" Grid.Row="3" Content="A 열" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                <Label Grid.Column="0" Grid.Row="4" Content="B 열" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                <Label Grid.Column="0" Grid.Row="5" Content="C 열" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                <Label Grid.Column="0" Grid.Row="6" Content="D 열" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                <ToggleSwitch:HorizontalToggleSwitch Width="95" Height="30" UncheckedContent="연결부 X" CheckedContent="연결부 O" x:Name="tsOrderBindCheck" Grid.Row="7" HorizontalAlignment="Center" IsChecked="false" Style="{StaticResource iOS5ToggleSwitchStyle}" PreviewMouseDown="tsOrderBindCheck_Click"/>
                <ToggleSwitch:HorizontalToggleSwitch Width="95" Height="30" UncheckedContent="완료부 X" CheckedContent="완료부 O" x:Name="tsOrderComplateCheck" Grid.Row="8" HorizontalAlignment="Center" IsChecked="false" Style="{StaticResource iOS5ToggleSwitchStyle}" PreviewMouseDown="tsOrderCompleteCheck_Click"/>

                <TextBox x:Name="tbModelName" Grid.Row="1" Grid.Column="2" Margin="15" FontFamily="Arial" FontSize="20" FontWeight="Bold" 
                     VerticalContentAlignment="Center" TextAlignment="Left" CharacterCasing="Upper"/>                
                <TextBox x:Name="tbLot" Grid.Row="2" Grid.Column="2" Margin="15" FontFamily="Arial" FontSize="20" FontWeight="Bold" 
                     VerticalContentAlignment="Center" TextAlignment="Left" CharacterCasing="Upper"/>
                <TextBox x:Name="tbLotA" Grid.Row="3" Grid.Column="2" Margin="15" FontFamily="Arial" FontSize="20" FontWeight="Bold" 
                     VerticalContentAlignment="Center" TextAlignment="Left" CharacterCasing="Upper"/>
                <TextBox x:Name="tbLotB" Grid.Row="4" Grid.Column="2" Margin="15" FontFamily="Arial" FontSize="20" FontWeight="Bold" 
                     VerticalContentAlignment="Center" TextAlignment="Left" CharacterCasing="Upper"/>
                <TextBox x:Name="tbLotC" Grid.Row="5" Grid.Column="2" Margin="15" FontFamily="Arial" FontSize="20" FontWeight="Bold" 
                     VerticalContentAlignment="Center" TextAlignment="Left" CharacterCasing="Upper"/>
                <TextBox x:Name="tbLotD" Grid.Row="6" Grid.Column="2" Margin="15" FontFamily="Arial" FontSize="20" FontWeight="Bold" 
                     VerticalContentAlignment="Center" TextAlignment="Left" CharacterCasing="Upper"/>
                <TextBox x:Name="tbOrderBindNumber" Grid.Row="7" Grid.Column="2" Margin="15" FontFamily="Arial" FontSize="20" FontWeight="Bold" TextChanged="tbOrderBindNumber_TextChanged"
                     VerticalContentAlignment="Center" TextAlignment="Left" IsEnabled="False" materialDesign:HintAssist.Hint="예상되는 연결부의 번호 입력"/>
                <TextBox x:Name="tbOrderComplateNumber" Grid.Row="8" Grid.Column="2" Margin="15" FontFamily="Arial" FontSize="20" FontWeight="Bold" TextChanged="tbOrderCompleteNumber_TextChanged"
                    VerticalContentAlignment="Center" TextAlignment="Left" IsEnabled="False" materialDesign:HintAssist.Hint="예상되는 완료부의 번호 입력"/>

                <StackPanel Grid.Row="9" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!--<Button x:Name="btnLot" Grid.Row="3" Width="120" Height="35" Margin="15, 0" Content="Lot 입력" Click="btnLot_Click"/>-->
                    <Button x:Name="btnOK" Click="btnOK_Click" Grid.Row="2" Width="200" Height="50" Margin="15, 0" FontSize="20" Content="확 인" Foreground="White" Cursor="Hand"/>
                    <Button x:Name="btnCancel" Click="btnClose_Click" Grid.Row="3" Width="200" Height="50" Margin="15, 0" FontSize="20" Content="취 소" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
