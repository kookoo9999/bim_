<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDS_ID_Marker.SubWindow" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:Data="clr-namespace:HDS_ID_Marker.Data" x:Class="HDS_ID_Marker.SubWindow.CustomInfoWindow"
        mc:Ignorable="d" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Roboto"        
        WindowStartupLocation="CenterScreen"
        Title="CustomInfoWindow" Height="800" Width="800" Loaded="Window_Loaded">
    <Window.Resources>
    </Window.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>

        <Grid>
            <materialDesign:ColorZone
                                Foreground="White"
                                Background="#4c7eb6"
                                Mode="Standard"
                                CornerRadius="3" 
                                materialDesign:ShadowAssist.ShadowDepth="Depth2" Height="50">
                <TextBlock
                                    x:Name="txtModelName" VerticalAlignment="Center" TextWrapping="Wrap" 
                                    HorizontalAlignment="Center"
                                    FontSize="25" FontWeight="Bold"
                                    FontFamily="Roboto"><Run Text="고객 정보 설정"/></TextBlock>
            </materialDesign:ColorZone>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="15">
                <materialDesign:DialogHost 
                                Style="{StaticResource MaterialDesignMJDialogHost}"
                                DialogOpened="DialogHost_DialogOpened"
                                DialogClosing="OnDialogClosing"
                                DialogMargin="8">
                    <materialDesign:DialogHost.DialogContent>
                        <StackPanel Margin="10">
                            <TextBlock Opacity="0.8"><Run Text="고객명"/></TextBlock>
                            <TextBox Margin="0 8 0 0" HorizontalAlignment="Stretch"  x:Name="tbAddCustomer"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource MaterialDesignFlatButton}" IsDefault="True" Margin="0 8 8 0" Command="materialDesign:DialogHost.CloseDialogCommand" Content="ADD">
                                    <Button.CommandParameter>
                                        <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">True</system:Boolean>
                                    </Button.CommandParameter>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignFlatButton}" IsCancel="True" Margin="0 8 8 0" Command="materialDesign:DialogHost.CloseDialogCommand" Content="CANCEL">
                                    <Button.CommandParameter>
                                        <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">False</system:Boolean>
                                    </Button.CommandParameter>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:DialogHost.DialogContent>
                    <Border BorderThickness="1" HorizontalAlignment="Stretch" BorderBrush="{DynamicResource PrimaryHueMidBrush}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox ItemsSource="{Binding CustomerInformation}" x:Name="lbCustomer" ScrollViewer.VerticalScrollBarVisibility="Visible" SelectionChanged="lbModel_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <materialDesign:ColorZone Mode="PrimaryMid" Grid.Row="1" Effect="{DynamicResource MaterialDesignShadowDepth5}">
                                <TextBlock Margin="10" FontSize="15" Foreground="White"><Run Text="관리 대상 고객"/></TextBlock>
                            </materialDesign:ColorZone>
                            <Button Foreground="White" FocusVisualStyle="{x:Null}" Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}" Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,67,18" Grid.RowSpan="2">
                                <materialDesign:PackIcon Kind="Plus" Height="22" Width="22"/>
                            </Button>
                            <Button Foreground="White" x:Name="btnDeleteCustomer" Panel.ZIndex="999" Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,528,10,0" Click="btnDeleteCustomer_Click" Grid.RowSpan="2">
                                <materialDesign:PackIcon Kind="Minus" Height="22" Width="22"/>
                            </Button>
                        </Grid>
                    </Border>
                </materialDesign:DialogHost>
            </Grid>
            <Grid Grid.Column="1" x:Name="dataField">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="1" Content="Customer Code" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20"/>
                <Label Grid.Column="0" Grid.Row="2" Content="Name" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20"/>
                <Label Grid.Column="0" Grid.Row="3" Content="마킹" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20"/>
                <Label Grid.Column="0" Grid.Row="4" Content="2D 위치(Strip 기준)" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" />
                <Label Grid.Column="0" Grid.Row="5" Content="마킹ID 길이" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" />
                <Label Grid.Column="0" Grid.Row="6" Content="마킹 규칙" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" />
                <Label Grid.Column="0" Grid.Row="8" Content="결과 미리보기" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" Foreground="#4c7eb6"/>

                <TextBox x:Name="tbCode" Grid.Column="1" Grid.Row="1" Style="{StaticResource SimpleTextBox}" Margin="5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20" TextChanged="tbCode_TextChanged"/>
                <TextBox x:Name="tbName" Grid.Column="1" Grid.Row="2" Style="{StaticResource SimpleTextBox}" Margin="5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20" TextChanged="tbName_TextChanged"/>
                <GroupBox x:Name="gbMark" Grid.Column="1" Grid.Row="3" Style="{StaticResource MaterialDesignHeaderedContentControl}" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="rbTop" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Content="상부" FontSize="18"/>
                        <RadioButton x:Name="rbBot" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Content="하부" FontSize="18"/>
                        <RadioButton x:Name="rbBoth" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Content="양면" FontSize="18"/>
                    </Grid>
                </GroupBox>
                <ComboBox x:Name="cbLocation" SelectedValuePath="Content" Grid.Column="1" Grid.Row="4" Margin="5" Style="{StaticResource MaterialDesignFilledComboBox}" SelectionChanged="cbLocation_SelectionChanged">
                    <ComboBoxItem Content="사내1 좌, 고객1 좌, 고객2 좌" Height="Auto" Width="Auto"/>
                    <ComboBoxItem Content="사내1 좌, 고객1 좌, 고객2 우" Height="Auto" Width="Auto"/>
                    <ComboBoxItem Content="사내1 좌, 고객1 우, 고객2 좌" Height="Auto" Width="Auto"/>
                    <ComboBoxItem Content="사내1 좌, 고객1 우, 고객2 우" Height="Auto" Width="Auto"/>
                    <ComboBoxItem Content="사내1 우, 고객1 좌, 고객2 좌" Height="Auto" Width="Auto"/>
                    <ComboBoxItem Content="사내1 우, 고객1 좌, 고객2 우" Height="Auto" Width="Auto"/>
                    <ComboBoxItem Content="사내1 우, 고객1 우, 고객2 좌" Height="Auto" Width="Auto"/>
                    <ComboBoxItem Content="사내1 우, 고객1 우, 고객2 우" Height="Auto" Width="Auto"/>
                </ComboBox>
                <TextBox x:Name="tbMark_Length" Grid.Column="1" Grid.Row="5" Style="{StaticResource SimpleTextBox}" Margin="5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20" TextChanged="tbMark_Length_TextChanged"/>
                <TextBox x:Name="tbMark_Format" Grid.Column="1" Grid.Row="6" Style="{StaticResource SimpleTextBox}" Margin="5,5,5,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="20" TextChanged="tbMark_Format_TextChanged"
                         materialDesign:HintAssist.Hint="H{YY}{M12}{LOT:5}{STRIP:5}">
                </TextBox>

                <!-- Quick Insert Buttons -->
                <WrapPanel Grid.Column="1" Grid.Row="7" Orientation="Horizontal" Margin="5,2,5,5">
                    <Button Content="년도(YY)" Margin="2" Padding="8,2" FontSize="12" Click="btnInsertFormat_Click" Tag="{}{YY}" Height="25"/>
                    <Button Content="월(A~C)" Margin="2" Padding="8,2" FontSize="12" Click="btnInsertFormat_Click" Tag="{}{M12}" Height="25"/>
                    <Button Content="월(MM)" Margin="2" Padding="8,2" FontSize="12" Click="btnInsertFormat_Click" Tag="{}{MM}" Height="25"/>
                    <Button Content="일(DD)" Margin="2" Padding="8,2" FontSize="12" Click="btnInsertFormat_Click" Tag="{}{DD}" Height="25"/>
                    <Button Content="LOT(5자리)" Margin="2" Padding="8,2" FontSize="12" Click="btnInsertFormat_Click" Tag="{}{LOT:5}" Height="25"/>
                    <Button Content="고객모델이름" Margin="2" Padding="8,2" FontSize="12" Click="btnInsertFormat_Click" Tag="{}{CUST}" Height="25"/>
                    <Button Content="STRIP(3자리)" Margin="2" Padding="8,2" FontSize="12" Click="btnInsertFormat_Click" Tag="{}{STRIP:3}" Height="25"/>
                    <Button Content="행(ROW)" Margin="2" Padding="8,2" FontSize="12" Click="btnInsertFormat_Click" Tag="{}{ROW}" Height="25"/>
                    <Button Content="하이픈(-)" Margin="2" Padding="8,2" FontSize="12" Click="btnInsertFormat_Click" Tag="-" Height="25"/>
                    <Button Content="지우기" Margin="10,2,2,2" Padding="8,2" FontSize="12" Click="btnClearFormat_Click" Background="Gray" BorderBrush="Gray" Height="25"/>
                </WrapPanel>

                <!-- Real-time Preview -->
                <Border Grid.Column="1" Grid.Row="8" Background="#F5F5F5" CornerRadius="5" Margin="5">
                    <TextBlock x:Name="tblPreview" Text="미리보기" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="Gray"/>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <StackPanel Grid.Row="2" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="btnSave" Click="btnSave_Click" Grid.Row="2" Width="150" Height="50" Margin="15, 0" FontSize="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="ContentSave" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                        <TextBlock FontWeight="Normal" FontSize="24" Text="저  장" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnEdit" Click="btnEdit_Click" Grid.Row="2" Width="150" Height="50" Margin="15, 0" FontSize="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="Edit" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                        <TextBlock FontWeight="Normal" FontSize="24" Text="수  정" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnCancel" Click="btnClose_Click" Grid.Row="3" Width="150" Height="50" Margin="15, 0" FontSize="24" Content="취  소" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
