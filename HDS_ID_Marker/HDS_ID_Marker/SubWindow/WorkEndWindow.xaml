<Window x:Class="HDS_ID_Marker.SubWindow.WorkEndWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDS_ID_Marker.SubWindow"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Roboto"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Title="작업 내역" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid Background="White" x:Name="gridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.ColumnSpan="3" Background="#4c7eb6">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <Label FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto" FontWeight="Bold" Foreground="White">제품 공급이 중단 되었습니다.
                </Label>
                <Label FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto" FontWeight="Bold" Foreground="White">현재 오더를 완료 하시겠습니까?
                </Label>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="1" Content="Lot :" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="25"/>
            <Label Grid.Row="0" Grid.Column="3" Content="Name :" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="25"/>

            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="25">
                <TextBlock>완료<LineBreak/>Strip ID :</TextBlock>
            </Label>
            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="등록시간:" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="25"/>

            <TextBlock x:Name="tbLot" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Text="123456789" FontSize="25"></TextBlock>
            <TextBlock x:Name="tbName" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Minjun" FontSize="25"></TextBlock>
            <TextBox x:Name="tbCurStripID" Grid.Row="1" Grid.Column="3" Style="{StaticResource MaterialDesignDataGridComboBoxEditableTextBox}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="25" Text="0"  Width="50" HorizontalContentAlignment="Center" IsReadOnly="True"></TextBox>
            <TextBlock x:Name="tbRegistTime" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Text="2021-01-01 00:00:00" FontSize="25"></TextBlock>
        </Grid>
        <Grid Grid.Row="2">
            <StackPanel Grid.Row="2" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="btnEnd" Click="btnEnd_Click" Grid.Row="2" Width="160" Height="50" Margin="15, 0" FontSize="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="ExitToApp" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                        <TextBlock FontWeight="Normal" FontSize="24" Text="오더 완료" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnCancel" Click="btnClose_Click" Grid.Row="3" Width="150" Height="50" Margin="15, 0" FontSize="24" Content="취  소" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>