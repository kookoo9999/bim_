<Window x:Class="HDS_ID_Marker.SubWindow.ITSHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Roboto"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Title="작업 내역" Height="450" Width="800" Loaded="Window_Loaded">

    <Grid Background="White" x:Name="gridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.ColumnSpan="3" Background="#CC0000">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <Label FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto" FontWeight="Bold" Foreground="White">중복 각인 정보가 존재합니다.
                </Label>
                <Label FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto" FontWeight="Bold" Foreground="White">제조기술에 문의 후 작업을 진행해 주세요.
                </Label>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="1" Content="Lot :" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="25"/>
            <Label Grid.Row="0" Grid.Column="3" Content="Name :" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="25"/>
            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="25">
                <TextBlock>마지막<LineBreak/>각인 이력 :</TextBlock>
            </Label>
            <Label Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="25">
                <TextBlock>중복<LineBreak/>각인 정보 :</TextBlock>
            </Label>

            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="25">
                <TextBlock>마지막<LineBreak/>작업 시간 :</TextBlock>
            </Label>

            <TextBlock x:Name="tbLot" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Text="123456789" FontSize="25"></TextBlock>
            <TextBlock x:Name="tbName" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Minjun" FontSize="25"></TextBlock>
            <TextBox x:Name="tbLastStripID" Grid.Row="1" Grid.Column="2" Style="{StaticResource MaterialDesignDataGridComboBoxEditableTextBox}"  VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="25" Text="123456789 0000" Width="Auto" HorizontalContentAlignment="Center" IsReadOnly="True"></TextBox>
            <TextBox x:Name="tbCurStripID" Grid.Row="1" Grid.Column="4" Style="{StaticResource MaterialDesignDataGridComboBoxEditableTextBox}"  VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="25" Text="123456789 0000" Width="Auto" HorizontalContentAlignment="Center" IsReadOnly="True" TextChanged="tbCurStripID_TextChanged"></TextBox>
            <TextBlock x:Name="tbRegistTime" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="2021-01-01 00:00:00" FontSize="25" Margin="10 0 0 0"></TextBlock>
        </Grid>
        <Grid Grid.Row="2">
            <StackPanel Grid.Row="2" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="btnCancel" Click="btnClose_Click" Grid.Row="3" Width="150" Height="50" Margin="15, 0" FontSize="24" Content="확  인" Foreground="White" Background="#CC0000"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
