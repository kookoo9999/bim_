                                        <Button Grid.Column="1" Grid.Row="2" Name="btnROIBottomMove" Cursor="Hand" Tag="Move Y ↓ Pixel" Style="{StaticResource MaterialDesignBlueCircleBtn}"
                    Width="50" Height="50">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="ArrowBottomBold" Width="40" Height="40" HorizontalAlignment="Center" Foreground="White"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="0" Grid.Row="1" Name="btnROILeftMove" Cursor="Hand" Tag="Move X ← Pixel" Style="{StaticResource MaterialDesignBlueCircleBtn}"
                    Width="50" Height="50">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="ArrowLeftBold" Width="40" Height="40" HorizontalAlignment="Center" Foreground="White"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Grid.Row="1" Name="btnROIRightMove" Cursor="Hand" Tag="Move X → Pixel" Style="{StaticResource MaterialDesignBlueCircleBtn}"
                    Width="50" Height="50">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="ArrowRightBold" Width="40" Height="40" HorizontalAlignment="Center" Foreground="White"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Expander>
                            </Grid>
                            <Grid Margin="15">
                                <Expander  materialDesign:ExpanderAssist.HeaderFontSize="35" Style="{StaticResource  MaterialDesignExpander}"
                                       ScrollViewer.VerticalScrollBarVisibility="Visible" Foreground="LightGoldenrodYellow" Margin="0 0 0 0" HorizontalAlignment="Stretch" Header="기구 제어" Background="#0C1E34">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="15"/>
                                            <RowDefinition/>
                                            <RowDefinition Height="15"/>
                                            <RowDefinition/>
                                            <RowDefinition Height="15"/>
                                            <RowDefinition/>
                                            <RowDefinition Height="15"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <Button x:Name="btnRollerUp" Click="btnRollerUp_Click" Grid.Column="0" Grid.Row="0" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="누름 롤러 상승">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="Firewire" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                <TextBlock FontWeight="Normal" FontSize="20" Text="롤러 상승" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnRollerDown" Click="btnRollerDown_Click" Grid.Column="2" Grid.Row="0" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="누름 롤러 하강">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="Firewire" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                <TextBlock FontWeight="Normal" FontSize="20" Text="롤러 하강" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="btnGripOn" Click="btnGripOn_Click" Grid.Column="0" Grid.Row="2" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="그립퍼 그립 on">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="DragHorizontalVariant" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                <TextBlock FontWeight="Normal" FontSize="20" Text="그립 On" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnGripOff" Click="btnGripOff_Click" Grid.Column="2" Grid.Row="2" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="그립퍼 그립 off" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="DragHorizontalVariant" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                <TextBlock FontWeight="Normal" FontSize="20" Text="그립 Off" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="btnTensionOn" Click="btnTensionOn_Click" Grid.Column="0" Grid.Row="4" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="그립퍼 텐션 on">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="CurrentDc" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                <TextBlock FontWeight="Normal" FontSize="20" Text="텐션 On" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnTensionOff" Click="btnTensionOff_Click" Grid.Column="2" Grid.Row="4" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="그립퍼 텐션 off" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="CurrentDc" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                <TextBlock FontWeight="Normal" FontSize="20" Text="텐션 Off" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="btnGrip" Click="btnGrip_Click" Grid.Column="0" Grid.Row="6" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="그립핑 ">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="NotificationClearAll" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                <TextBlock FontWeight="Normal" FontSize="20" Text="그립핑 On" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnRelease" Click="btnRelease_Click" Grid.Column="2" Grid.Row="6" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="그립퍼 텐션 off" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="NotificationClearAll" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                <TextBlock FontWeight="Normal" FontSize="20" Text="그립핑 Off" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="btnSuctionOn" Click="btnSuctionOn_Click" Grid.Column="0" Grid.Row="8" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="집진기 on ">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="WeatherWindy" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                <TextBlock FontWeight="Normal" FontSize="20" Text="집진기 On" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnSuctionOff" Click="btnSuctionOff_Click" Grid.Column="2" Grid.Row="8" Width="170" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="집진기 off" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="WeatherWindy" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                <TextBlock FontWeight="Normal" FontSize="20" Text="집진기 Off" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                            </StackPanel>
                                        </Button>

                                    </Grid>
                                </Expander>
                            </Grid>
                            <Grid Margin="15">
                                <Expander  materialDesign:ExpanderAssist.HeaderFontSize="35" Style="{StaticResource  MaterialDesignExpander}"
                                       ScrollViewer.VerticalScrollBarVisibility="Visible" Foreground="LightGoldenrodYellow" Margin="0 0 0 0" HorizontalAlignment="Stretch" Header="AOI 마크 확인" Background="#0C1E34">
                                    <Grid Margin="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="200"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="2*"/>
                                        </Grid.RowDefinitions>

                                        <Border Background="#1e252e" Grid.Row="0" BorderThickness="2" BorderBrush="#b2b2b2" Margin="50 0 50 0">
                                            <Grid>
                                                <!--<dcs:KeyenceIDReader x:Name="idReaderControl" Background="Red"></dcs:KeyenceIDReader>-->
                                                <Image x:Name="imgAOIMark" Stretch="Uniform" Margin="50 0 50 0"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="1" Margin="1,20,0,20" CornerRadius="3 3 3 3" Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="../images/ID_Matrix.png" Width="40"/>
                                                        <Label Content="인식결과" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Grid Grid.Column="1">
                                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                        <TextBox
                                        x:Name="tbAOIMarkResult"
                                         Style="{StaticResource SimpleTextBox}"
                                         VerticalContentAlignment="Center"
                                         Grid.Column="1"
                                         Margin="3"
                                         materialDesign:HintAssist.Hint="Result of AOI Recognition"
                                         BorderThickness="1"
                                         Height="30"
                                         VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>


                                            </Grid>
                                        </Border>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <Button x:Name="btnAOIMarkRead" Height="50" Width="110"  FontSize="20"  
                                                    Background="#16365d" ToolTip="AOI 마크 인식" Cursor="Hand" HorizontalAlignment="Left" Click="btnAOIMarkRead_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Read" Height="30" Width="30" Foreground="white"/>
                                                    <TextBlock FontWeight="Normal" FontSize="20" Text="인식" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                </StackPanel>
                                            </Button>

                                        </Grid>
                                    </Grid>
                                </Expander>
                            </Grid>
                            <Grid Margin="15">
                                <Expander  materialDesign:ExpanderAssist.HeaderFontSize="35" Style="{StaticResource  MaterialDesignExpander}"
                                       ScrollViewer.VerticalScrollBarVisibility="Visible" Foreground="LightGoldenrodYellow" Margin="0 0 0 0" HorizontalAlignment="Stretch" Header="Mark Position" Background="#0C1E34">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Column="1" Grid.ColumnSpan="2" Background="#195aa2" CornerRadius="2,2,2,2" Margin="2"></Border>
                                        <Border Grid.Row="1" Grid.RowSpan="4" Background="#195aa2" CornerRadius="2,2,2,2" Margin="2"></Border>
                                        <Label Grid.Column="1" Grid.Row="0" Content="X" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                                        <Label Grid.Column="2" Grid.Row="0" Content="Y" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                                        <Label Grid.Column="0" Grid.Row="1" Content="Align" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                                        <Label Grid.Column="0" Grid.Row="2" Content="Top" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                                        <Label Grid.Column="0" Grid.Row="3" Content="Bot" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                                        <Label x:Name="lblAlignMotionPosX" Grid.Column="1" Grid.Row="1" Content="0" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="white"/>
                                        <Label x:Name="lblAlignMotionPosY" Grid.Column="2" Grid.Row="1" Content="0" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                                        <Label x:Name="lblTopMotionPosY" Grid.Column="2" Grid.Row="2" Content="0" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                                        <Label x:Name="lblBotMotionPosY" Grid.Column="2" Grid.Row="3" Content="0" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                                    </Grid>
                                </Expander>
                            </Grid>                            
                        </StackPanel>
                    </materialDesign:ColorZone>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="1" Background="#0C1E34">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnSave" Click="btnSave_Click" Grid.Row="2" Width="150" Height="50" Margin="15, 0" FontSize="20"
                            Background="#16365d" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="ContentSave" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="30" Text="저 장" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>
                    <Separator Width="10" Style="{StaticResource MaterialDesignDarkSeparator}"/>
                    <Button x:Name="btnDelete" Click="btnDelete_Click" Grid.Row="2" Width="155" Height="50" Margin="15, 0" FontSize="20"
                            Background="#16365d" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="ContentCut" Margin="0 0 0 0" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="30" Text="초기화" VerticalAlignment="Center" Margin="5, 0, 0, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>
                    <Separator Width="10" Style="{StaticResource MaterialDesignDarkSeparator}"/>
                    <Button x:Name="btnCancel" Click="btnCancel_Click" Grid.Row="2" Width="150" Height="50" Margin="15, 0" FontSize="20"
                            Background="#16365d" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="CancelBoxOutline" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                            <TextBlock FontWeight="Normal" FontSize="30" Text="닫 기" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Window>
