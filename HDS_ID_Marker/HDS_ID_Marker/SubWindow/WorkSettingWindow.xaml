<Window x:Class="HDS_ID_Marker.SubWindow.WorkSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDS_ID_Marker"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
         xmlns:dcs ="clr-namespace:DCS.IDReader;assembly=DCS"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        mc:Ignorable="d" FontFamily="Roboto" KeyDown="Window_KeyDown" KeyUp="Window_KeyUp" IsVisibleChanged="Window_IsVisibleChanged"
        Title="WorkSettingWindow" Height="1080" Width="1920">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1369"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <materialDesign:Transitioner x:Name="tsMain" SelectedIndex="0" AutoApplyTransitionOrigins="True">
                <materialDesign:Transitioner.InputBindings>
                    <KeyBinding Key="Left" Command="{x:Static materialDesign:Transitioner.MovePreviousCommand}"/>
                    <KeyBinding Key="Right" Command="{x:Static materialDesign:Transitioner.MoveNextCommand}"/>
                </materialDesign:Transitioner.InputBindings>
                <materialDesign:TransitionerSlide x:Name="topEffect" OpeningEffect="{materialDesign:TransitionEffect Kind=SlideInFromLeft}" >
                    <Grid>
                        <local:MainHRControl x:Name="topHRControl"></local:MainHRControl>
                        <Canvas  x:Name="topZoomedViewCanvas" RenderTransformOrigin="0.5,0.5" Margin="1109,820,10,10" Width="250" Height="250">
                            <Ellipse Fill="Red" Width="4" Height="4" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="125,125,0,0"></Ellipse>
                        </Canvas>
                        <Border BorderThickness="2" BorderBrush="White"  Margin="1107,818,8,8" Width="254" Height="254">
                        </Border>
                        
                    </Grid>
                </materialDesign:TransitionerSlide>
                <materialDesign:TransitionerSlide x:Name="botEffect" OpeningEffect="{materialDesign:TransitionEffect Kind=SlideInFromRight}">
                    <Grid>
                        <local:MainHRControl x:Name="botHRControl"></local:MainHRControl>
                        <Border BorderThickness="2" BorderBrush="White"  Margin="1107,818,8,8" Width="254" Height="254">
                        </Border>
                        <Canvas  x:Name="botZoomedViewCanvas" RenderTransformOrigin="0.5,0.5" Margin="1109,820,10,10" Width="250" Height="250">
                            <Ellipse Fill="Red" Width="4" Height="4" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="125,125,0,0"></Ellipse>
                        </Canvas>
                        
                    </Grid>
                </materialDesign:TransitionerSlide>
            </materialDesign:Transitioner>
        </Grid>

        <Grid Grid.Column="1" Background="#0C1E34">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid Background="#0C1E34" Grid.Row="0">
                    <materialDesign:ColorZone
                                Mode="Custom"
                                Background="#0C1E34"
                                CornerRadius="10"
                                Margin="5"
                                materialDesign:ShadowAssist.ShadowDepth="Depth0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <StackPanel x:Name="pnl_Functions" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid Margin="15" >
                                <Expander  materialDesign:ExpanderAssist.HeaderFontSize="35" Style="{StaticResource  MaterialDesignExpander}"
                                       ScrollViewer.VerticalScrollBarVisibility="Visible" Foreground="LightGoldenrodYellow" Margin="0 0 0 0" HorizontalAlignment="Stretch" Header="모드 선택" Background="#0C1E34">
                                    <Grid Margin="10">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="rbModeTop" Style="{StaticResource MaterialDesignUserForegroundRadioButton}" Content="  상부" FontSize="25" Foreground="White"/>
                                            <Separator Style="{StaticResource MaterialDesignDarkSeparator}" Width="100"/>
                                            <RadioButton x:Name="rbModeBot" Style="{StaticResource MaterialDesignUserForegroundRadioButton}" Content="  하부" FontSize="25" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander>
                            </Grid>
                            <Grid Margin="15" >
                                <Expander  materialDesign:ExpanderAssist.HeaderFontSize="35" Style="{StaticResource  MaterialDesignExpander}"
           ScrollViewer.VerticalScrollBarVisibility="Visible" Foreground="LightGoldenrodYellow" Margin="0 0 0 0" HorizontalAlignment="Stretch" Header="Grid View" Background="#0C1E34">
                                    <Grid Margin="10">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="rbGridOn" Style="{StaticResource MaterialDesignUserForegroundRadioButton}" Content=" On" FontSize="25" Foreground="White"/>
                                            <Separator Style="{StaticResource MaterialDesignDarkSeparator}" Width="100"/>
                                            <RadioButton x:Name="rbGridOff" Style="{StaticResource MaterialDesignUserForegroundRadioButton}" Content=" Off" FontSize="25" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander>
                            </Grid>
                            <Grid Margin="15">
                                <Expander materialDesign:ExpanderAssist.HeaderFontSize="35" Style="{StaticResource  MaterialDesignExpander}"
                                          ScrollViewer.VerticalScrollBarVisibility="Visible" Foreground="LightGoldenrodYellow" Margin="0 0 0 0" HorizontalAlignment="Stretch" Header="Align" Background="#0C1E34">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="200"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Width="Auto" Grid.Row="0" BorderThickness="1" BorderBrush="#b2b2b2" Margin="0 0 0 0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="Auto" Grid.Column="0" BorderThickness="1" BorderBrush="#b2b2b2" Margin="0 0 0 0">
                                                    <Image x:Name="imgtemplate" Grid.Column="0" Stretch="Uniform"/>
                                                </Border>
                                                <Border Width="Auto" Grid.Column="1" BorderThickness="1" BorderBrush="#b2b2b2" Margin="0 0 0 0">
                                                    <Image x:Name="imgAlign" Grid.Column="1" Stretch="Uniform"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Vertical" Grid.Row="1">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Label Foreground="White" VerticalContentAlignment="Center" FontSize="30">X :</Label>
                                                <Label x:Name="lblAlignOffsetX" Foreground="White" VerticalContentAlignment="Center" FontSize="30">0</Label>
                                                <Separator Width="15" Style="{StaticResource MaterialDesignDarkSeparator}"/>
                                                <Label Foreground="White" VerticalContentAlignment="Center" FontSize="30">Y :</Label>
                                                <Label x:Name="lblAlignOffsetY" Foreground="White" VerticalContentAlignment="Center" FontSize="30">0</Label>
                                                <Separator Width="15" Style="{StaticResource MaterialDesignDarkSeparator}"/>
                                                <Label Foreground="White" VerticalContentAlignment="Center" FontSize="30">Match :</Label>
                                                <Label x:Name="lblAlignMatch" Foreground="White" VerticalContentAlignment="Center" FontSize="30">0</Label>
                                            </StackPanel>
                                            <Separator Height="10" Style="{StaticResource MaterialDesignDarkSeparator}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Label Content="크기 : " Foreground="White" FontSize="30"/>
                                                <TextBox x:Name="tbAlignSize" Width="50" Style="{StaticResource SimpleTextBox}"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         Grid.Column="1"
                                         Margin="3"
                                         materialDesign:HintAssist.Hint="Align 크기"
                                         BorderThickness="1"
                                         Height="30" Text="2" FontSize="20"
                                         VerticalAlignment="Center" TextChanged="tbAlignSize_TextChanged"/>
                                                <Label Content="mm" Foreground="White" FontSize="30" />

                                                <Label Content="매칭율 : " Foreground="White" FontSize="30"/>
                                                <TextBox x:Name="tbAlignMatch" Width="50" Style="{StaticResource SimpleTextBox}"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         Grid.Column="1"
                                         Margin="3"
                                         materialDesign:HintAssist.Hint="Align 매칭율"
                                         BorderThickness="1"
                                         Height="30" Text="80" FontSize="20"
                                         VerticalAlignment="Center" TextChanged="tbAlignMatch_TextChanged"/>
                                                <Label Content="%" Foreground="White" FontSize="30" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                                                <Label Content="타입 : " Foreground="White" FontSize="30"/>
                                                <ComboBox x:Name="cbAlignType" FontSize="30" Width="100" Style="{StaticResource ComboBoxStyle1}" SelectionChanged="cbAlignType_SelectionChanged">
                                                    <ComboBoxItem Content="0"/>
                                                    <ComboBoxItem Content="1"/>
                                                    <ComboBoxItem Content="2"/>
                                                    <ComboBoxItem Content="3"/>
                                                    <ComboBoxItem Content="4"/>
                                                    <ComboBoxItem Content="5"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <Separator Height="10" Style="{StaticResource MaterialDesignDarkSeparator}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Grid.Row="0" Grid.Column="0" Padding="0" Height="50" Width="130" Margin="0" FontSize="20" x:Name="btnAlignROI" Background="#16365d" ToolTip="Align 영역 추가" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CropFree" Height="30" Width="30" Foreground="Aquamarine"/>
                                                        <TextBlock FontWeight="Normal" FontSize="20" Text="영역1 추가" VerticalAlignment="Center" Margin="0, 0, 5, 0" Foreground="white"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Row="0" Grid.Column="0" Padding="0" Height="50" Width="130" Margin="15 0 0 0" FontSize="20" x:Name="btnAlignMove" Background="#16365d" ToolTip="Align 확인">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="MoveToInbox" Height="30" Width="30" Foreground="Aquamarine"/>
                                                        <TextBlock FontWeight="Normal" FontSize="20" Text="위치 이동" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Row="0" Grid.Column="0" Padding="0" Height="50" Width="130" Margin="15 0 0 0" FontSize="20" x:Name="btnAlign" Background="#16365d" ToolTip="Align 확인" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Plus" Height="30" Width="30" Foreground="Aquamarine"/>
                                                        <TextBlock FontWeight="Normal" FontSize="20" Text="Align1" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <Separator Height="10" Style="{StaticResource MaterialDesignDarkSeparator}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Grid.Row="0" Grid.Column="0" Padding="0" Height="50" Width="130" Margin="0" FontSize="20" x:Name="btnAlign2ROI" Background="#16365d" ToolTip="Align2 영역 추가" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CropFree" Height="30" Width="30" Foreground="Aquamarine"/>
                                                        <TextBlock FontWeight="Normal" FontSize="20" Text="영역2 추가" VerticalAlignment="Center" Margin="0, 0, 5, 0" Foreground="white"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Row="0" Grid.Column="0" Padding="0" Height="50" Width="130" Margin="15 0 0 0" FontSize="20" x:Name="btnAlign2Move" Background="#16365d" ToolTip="Align 확인">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="MoveToInbox" Height="30" Width="30" Foreground="Aquamarine"/>
                                                        <TextBlock FontWeight="Normal" FontSize="20" Text="위치 이동" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Row="0" Grid.Column="0" Padding="0" Height="50" Width="130" Margin="15 0 0 0" FontSize="20" x:Name="btnAlign2" Background="#16365d" ToolTip="Align 확인" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Plus" Height="30" Width="30" Foreground="Aquamarine"/>
                                                        <TextBlock FontWeight="Normal" FontSize="20" Text="Align2" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Expander>
                            </Grid>
                            <Grid Margin="15">
                                <Expander  materialDesign:ExpanderAssist.HeaderFontSize="35" Style="{StaticResource  MaterialDesignExpander}"
                                       ScrollViewer.VerticalScrollBarVisibility="Visible" Foreground="LightGoldenrodYellow" Margin="0 0 0 0" HorizontalAlignment="Stretch" Header="고객 마킹 설정" Background="#0C1E34">
                                    <Grid Margin="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="200"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="2*"/>
                                        </Grid.RowDefinitions>

                                        <Border Background="#1e252e" Grid.Row="0" BorderThickness="2" BorderBrush="#b2b2b2" Margin="50 0 50 0">
                                            <Grid>
                                                <Image x:Name="imgCustomMark" Stretch="Uniform" Margin="50 0 50 0"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="1" Margin="1,20,0,20" CornerRadius="3 3 3 3" Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="../images/ID_Matrix.png" Width="40"/>
                                                        <Label Content="인식결과" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Grid Grid.Column="1">
                                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                        <TextBox
                                        x:Name="tbCustomMatrixMarkResult"
                                         Style="{StaticResource SimpleTextBox}"
                                         VerticalContentAlignment="Center"
                                         Grid.Column="1"
                                         Margin="3"
                                         materialDesign:HintAssist.Hint="Result of Custom Recognition"
                                         BorderThickness="1"
                                         Height="30"
                                         VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2" Grid.Column="1" Margin="1,0,0,20" CornerRadius="3 3 3 3" Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="../images/ID_Matrix.png" Width="40"/>
                                                        <Label Content="수동 데이터 입력" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Grid Grid.Column="1">
                                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                        <TextBox
                                        x:Name="tbCustomRandomMark"
                                         Style="{StaticResource SimpleTextBox}"
                                         VerticalContentAlignment="Center"
                                         Grid.Column="1"
                                         Margin="3"
                                         materialDesign:HintAssist.Hint="수동 마킹 데이터 입력 기능"
                                         BorderThickness="1"
                                         Height="30"
                                         VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <Button x:Name="btnCustomMarkSetting" Click="btnCustomMarkSetting_Click" Grid.Column="0" Grid.Row="0" Width="160" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="고객 마킹 파라미터 설정">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <materialDesign:PackIcon Kind="CogOutline" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                    <TextBlock FontWeight="Normal" FontSize="20" Text="마크 설정" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="btnCustomMarkROI" Grid.Column="0" Grid.Row="2"  Height="50" Width="160"  FontSize="20"  
                                                    Background="#16365d" ToolTip="고객 마킹 영역 추가">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CropFree" Height="30" Width="30" Foreground="Yellow"/>
                                                    <TextBlock FontWeight="Normal" FontSize="20" Text="영역 추가" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="btnCustomMarkMove" Grid.Column="2" Grid.Row="0" Width="160" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="고객 마킹 위치로 이동">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <materialDesign:PackIcon Kind="MoveToInbox" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                    <TextBlock FontWeight="Normal" FontSize="20" Text="마킹 위치" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="btnCustomCamMove" Grid.Column="2" Grid.Row="2"  Height="50" Width="160"  FontSize="20"  
                                                    Background="#16365d" ToolTip="고객 마크 카메라 위치로 이동" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Camera" Height="30" Width="30" Foreground="white"/>
                                                    <TextBlock FontWeight="Normal" FontSize="20" Text="Cam 위치" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="btnCustomMarking" Grid.Column="4" Grid.Row="0" Width="110" Height="50"  FontSize="20"
                                                    Background="#16365d" ToolTip="고객 마크 마킹" Cursor="Hand" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <materialDesign:PackIcon Kind="Marker" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                    <TextBlock FontWeight="Normal" FontSize="20" Text="마킹" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="btnCustomMarkRead" Grid.Column="4" Grid.Row="2"  Height="50" Width="110"  FontSize="20"  
                                                    Background="#16365d" ToolTip="고객 마크 인식" Cursor="Hand" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Read" Height="30" Width="30" Foreground="white"/>
                                                    <TextBlock FontWeight="Normal" FontSize="20" Text="인식" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                </StackPanel>
                                            </Button>

                                        </Grid>
                                    </Grid>
                                </Expander>
                            </Grid>
                            <Grid Margin="15">
                                <Expander  materialDesign:ExpanderAssist.HeaderFontSize="35" Style="{StaticResource  MaterialDesignExpander}"
                                       ScrollViewer.VerticalScrollBarVisibility="Visible" Foreground="LightGoldenrodYellow" Margin="0 0 0 0" HorizontalAlignment="Stretch" Header="사내 마킹 설정" Background="#0C1E34">
                                    <Grid Margin="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="200"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="2*"/>
                                        </Grid.RowDefinitions>

                                        <Border Background="#1e252e" Grid.Row="0" BorderThickness="2" BorderBrush="#b2b2b2" Margin="50 0 50 0">
                                            <Grid>
                                                <Image x:Name="imgInterMark" Stretch="Uniform" Margin="50 0 50 0"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="1" Margin="1,20,0,20" CornerRadius="3 3 3 3" Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="../images/ID_Matrix.png" Width="40"/>
                                                        <Label Content="인식결과" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Grid Grid.Column="1">
                                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                        <TextBox
                                        x:Name="tbInterMatrixMarkResult"
                                         Style="{StaticResource SimpleTextBox}"
                                         VerticalContentAlignment="Center"
                                         Grid.Column="1"
                                         Margin="3"
                                         materialDesign:HintAssist.Hint="Result of Inter Recognition"
                                         BorderThickness="1"
                                         Height="30"
                                         VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <Button x:Name="btnInterMarkSetting" Click="btnInterMarkSetting_Click" Grid.Column="0" Grid.Row="0" Width="160" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="사내 마킹 파라미터 설정">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <materialDesign:PackIcon Kind="CogOutline" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                    <TextBlock FontWeight="Normal" FontSize="20" Text="마크 설정" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="btnInterMarkROI" Grid.Column="0" Grid.Row="2"  Height="50" Width="160"  FontSize="20"  
                                                    Background="#16365d" ToolTip="고객 마킹 영역 추가">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CropFree" Height="30" Width="30" Foreground="LawnGreen"/>
                                                    <TextBlock FontWeight="Normal" FontSize="20" Text="영역 추가" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="btnInterMarkMove" Grid.Column="2" Grid.Row="0" Width="160" Height="50" FontSize="20"
                                                    Background="#16365d" ToolTip="사내 마킹 위치로 이동">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <materialDesign:PackIcon Kind="MoveToInbox" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
                                                    <TextBlock FontWeight="Normal" FontSize="20" Text="마킹 위치" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="btnInterCamMove" Grid.Column="2" Grid.Row="2"  Height="50" Width="160"  FontSize="20"  
                                                    Background="#16365d" ToolTip="사내 마크 카메라 위치로 이동" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Camera" Height="30" Width="30" Foreground="white"/>
                                                    <TextBlock FontWeight="Normal" FontSize="20" Text="Cam 위치" VerticalAlignment="Center" Margin="5, 0, 5, 0" Foreground="white"/>
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="btnInterMarking" Grid.Column="4" Grid.Row="0" Width="110" Height="50"  FontSize="20"
                                                    Background="#16365d" ToolTip="사내 마크 마킹" Cursor="Hand" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <materialDesign:PackIcon Kind="Marker" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="white"/>
