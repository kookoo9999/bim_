                    </materialDesign:ColorZone>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Top Origin Y" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding TopOriginY}" x:Name="tbTopOriginY" Grid.Column="1" Grid.Row="0" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Bot Origin Y" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotOriginY}" x:Name="tbBotOriginY" Grid.Column="1" Grid.Row="1" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="AOI Origin X" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding AOIOriginX}" x:Name="tbAOIOriginX" Grid.Column="1" Grid.Row="2" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="2" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Uncoiler Tension" VerticalAlignment="Center"/>
                    <common:NumberTextBox  x:Name="tbUncoilerTension" Grid.Column="1" Grid.Row="3" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="10" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="3" Grid.Column="2" Content="m/s" VerticalAlignment="Center"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Recoiler Tension" VerticalAlignment="Center"/>
                    <common:NumberTextBox  x:Name="tbRecoilerTension" Grid.Column="1" Grid.Row="4" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="10" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="4" Grid.Column="2" Content="m/s" VerticalAlignment="Center"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="Gripper Speed" VerticalAlignment="Center"/>
                    <common:NumberTextBox  x:Name="tbGripperSpeed" Grid.Column="1" Grid.Row="5" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="200" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="5" Grid.Column="2" Content="m/s" VerticalAlignment="Center"/>

                    <Label Grid.Row="6" Grid.Column="0" Content="Uncoiler Speed" VerticalAlignment="Center"/>
                    <common:NumberTextBox  x:Name="tbUncoilerSpeed" Grid.Column="1" Grid.Row="6" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="200" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="6" Grid.Column="2" Content="m/s" VerticalAlignment="Center"/>

                    <Label Grid.Row="7" Grid.Column="0" Content="Recoiler Speed" VerticalAlignment="Center"/>
                    <common:NumberTextBox  x:Name="tbRecoilerSpeed" Grid.Column="1" Grid.Row="7" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="200" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="7" Grid.Column="2" Content="m/s" VerticalAlignment="Center"/>

                </Grid>
            </Grid>
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="0,0,0,0" Margin="1">
                    <materialDesign:ColorZone
                                Mode="Custom"
                                Background="#8b6e60"
                                CornerRadius="3" 
                                materialDesign:ShadowAssist.ShadowDepth="Depth2" Height="23">
                        <TextBlock Text="Motion" Margin="0" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold" Foreground="White" FontSize="14"/>
                    </materialDesign:ColorZone>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Top Offset X1" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding TopOffsetX1}" x:Name="tbTopOffsetX1" Grid.Column="1" Grid.Row="0" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    <Label Grid.Row="1" Grid.Column="0" Content="Top Offset Y1" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding TopOffsetY1}" x:Name="tbTopOffsetY1" Grid.Column="1" Grid.Row="1" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    <Label Grid.Row="2" Grid.Column="0" Content="Top Offset X2" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding TopOffsetX2}" x:Name="tbTopOffsetX2" Grid.Column="1" Grid.Row="2" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="2" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    <Label Grid.Row="3" Grid.Column="0" Content="Top Offset Y2" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding TopOffsetY2}" x:Name="tbTopOffsetY2" Grid.Column="1" Grid.Row="3" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="3" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    <Label Grid.Row="4" Grid.Column="0" Content="Top Offset X3" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding TopOffsetX3}" x:Name="tbTopOffsetX3" Grid.Column="1" Grid.Row="4" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="4" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    <Label Grid.Row="5" Grid.Column="0" Content="Top Offset Y3" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding TopOffsetY3}" x:Name="tbTopOffsetY3" Grid.Column="1" Grid.Row="5" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="5" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    <Label Grid.Row="6" Grid.Column="0" Content="Top Offset X4" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding TopOffsetX4}" x:Name="tbTopOffsetX4" Grid.Column="1" Grid.Row="6" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="6" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    <Label Grid.Row="7" Grid.Column="0" Content="Top Offset Y4" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding TopOffsetY4}" x:Name="tbTopOffsetY4" Grid.Column="1" Grid.Row="7" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="7" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    
                    <Label Grid.Row="8" Grid.Column="0" Content="Bot Offset X1" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotOffsetX1}" x:Name="tbBotOffsetX1" Grid.Column="1" Grid.Row="8" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="8" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    <Label Grid.Row="9" Grid.Column="0" Content="Bot Offset Y1" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotOffsetY1}" x:Name="tbBotOffsetY1" Grid.Column="1" Grid.Row="9" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="9" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    <Label Grid.Row="10" Grid.Column="0" Content="Bot Offset X2" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotOffsetX2}" x:Name="tbBotOffsetX2" Grid.Column="1" Grid.Row="10" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="10" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    <Label Grid.Row="11" Grid.Column="0" Content="Bot Offset Y2" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotOffsetY2}" x:Name="tbBotOffsetY2" Grid.Column="1" Grid.Row="11" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="11" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    <Label Grid.Row="12" Grid.Column="0" Content="Bot Offset X3" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotOffsetX3}" x:Name="tbBotOffsetX3" Grid.Column="1" Grid.Row="12" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="12" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    <Label Grid.Row="13" Grid.Column="0" Content="Bot Offset Y3" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotOffsetY3}" x:Name="tbBotOffsetY3" Grid.Column="1" Grid.Row="13" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="13" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>
                    <Label Grid.Row="14" Grid.Column="0" Content="Bot Offset X4" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotOffsetX4}" x:Name="tbBotOffsetX4" Grid.Column="1" Grid.Row="14" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
