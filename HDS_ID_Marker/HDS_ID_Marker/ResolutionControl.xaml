                    <Label Grid.Row="0" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Bottom Resolution" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotCamResolution}" x:Name="tbBotCamResolution" Grid.Column="1" Grid.Row="1" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Align Resolution" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding AlignCamResolution}" x:Name="tbAlignCamResolution" Grid.Column="1" Grid.Row="2" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="2" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>

                </Grid>
            </Grid>
            <Grid Grid.Column="2">
