                    <Label Grid.Row="15" Grid.Column="0" Content="Bot Offset Y4" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotOffsetY4}" x:Name="tbBotOffsetY4" Grid.Column="1" Grid.Row="15" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
