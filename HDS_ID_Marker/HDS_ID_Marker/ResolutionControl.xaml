<mah:MetroWindow x:Class="HDS_ID_Marker.ResolutionControl"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Icon="./images/settings.ico" WindowStartupLocation="CenterScreen"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:common="clr-namespace:Common;assembly=Common"
        mc:Ignorable="d" FontFamily="Roboto" BorderThickness="1" BorderBrush="Gray" AllowsTransparency="True" WindowTitleBrush="White" Topmost="True"
        Title="해상도 설정" Height="500" Width="1250">
    <Grid x:Name="gridResolutionInfo">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="0,0,0,0" Margin="1">
                    <materialDesign:ColorZone
                                Mode="Custom"
                                Background="#8b6e60"
                                CornerRadius="3" 
                                materialDesign:ShadowAssist.ShadowDepth="Depth2" Height="23">
                        <TextBlock Text="Laser" Margin="0" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold" Foreground="White" FontSize="14"/>
                    </materialDesign:ColorZone>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Top Offset X" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding TopOffsetX}" x:Name="tbTopOffsetX" Grid.Column="1" Grid.Row="0" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Top Offset Y" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding TopOffsetY}" x:Name="tbTopOffsetY" Grid.Column="1" Grid.Row="1" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Top Angle" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding TopAngle}" x:Name="tbTopAngle" Grid.Column="1" Grid.Row="2" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="2" Grid.Column="2" Content="º" VerticalAlignment="Center"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Top Focus Limit" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding TopFocusLimit}" x:Name="tbTopFocusLimit" Grid.Column="1" Grid.Row="3" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="3" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Bot Offset X" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotOffsetX}" x:Name="tbBotOffsetX" Grid.Column="1" Grid.Row="4" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="4" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="Bot Offset Y" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotOffsetY}" x:Name="tbBotOffsetY" Grid.Column="1" Grid.Row="5" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="5" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>

                    <Label Grid.Row="6" Grid.Column="0" Content="Bot Angle" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotAngle}" x:Name="tbBotAngle" Grid.Column="1" Grid.Row="6" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="0.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="6" Grid.Column="2" Content="º" VerticalAlignment="Center"/>

                    <Label Grid.Row="7" Grid.Column="0" Content="Bot Focus Limit" VerticalAlignment="Center"/>
                    <common:NumberTextBox Text="{Binding BotFocusLimit}" x:Name="tbBotFocusLimit" Grid.Column="1" Grid.Row="7" Style="{StaticResource MaterialDesignTextBox}" FontSize="14"  HorizontalAlignment="Center" MinValue="-100.000" MaxValue="100.000" HorizontalContentAlignment="Right" Height="25" Width="90"/>
                    <Label Grid.Row="7" Grid.Column="2" Content="mm" VerticalAlignment="Center"/>

                </Grid>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="0,0,0,0" Margin="1">
                    <materialDesign:ColorZone
                                Mode="Custom"
                                Background="#8b6e60"
                                CornerRadius="3" 
                                materialDesign:ShadowAssist.ShadowDepth="Depth2" Height="23"/>
                </Border>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="0,0,0,0" Margin="1">
                    <materialDesign:ColorZone
                                Mode="Custom"
                                Background="#8b6e60"
                                CornerRadius="3" 
                                materialDesign:ShadowAssist.ShadowDepth="Depth2" Height="23">
                        <TextBlock Text="Camera" Margin="0" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold" Foreground="White" FontSize="14"/>
                    </materialDesign:ColorZone>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

